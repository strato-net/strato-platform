# Install as /etc/strato-across/runtime.env with owner root:root and mode 0600.
# The referenced files must be regular, non-symlink files owned by
# strato-across:strato-across with mode 0600.
LOCAL_AUTH_PASSWORD_FILE=/etc/strato-across/admin-password
LOCAL_AUTH_PRIVATE_KEY_FILE=/etc/strato-across/validator-private-key
ACROSS_VALIDATOR_ADDRESS=0x0000000000000000000000000000000000000000
