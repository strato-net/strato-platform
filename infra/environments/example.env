# example: every setting scripts/ha.sh reads, with placeholder values. Copy it
# to <env>.env in a directory outside this repository, set HA_ENV_DIR to that
# directory and run scripts/ha.sh <env> <command>. Only settings live in such
# a file: names and ids other stacks produce are read from those stacks at
# deploy time, and the image set is what the autobuild published for the
# commit checked out.

ENV_NAME=example                     # the file's name; every AWS name starts with ha-example
AWS_REGION=us-east-1

NETWORK=helium                       # the STRATO network the cells follow
CHAIN_ID=195049586845898             # that network's chain id
NODE_HOSTNAME=node.example.com       # the environment's public hostname
# ACM, us-east-1, for NODE_HOSTNAME: serves CloudFront and both ALBs. The
# hostname's DNS record is a CNAME to the front door's DistributionDomainName,
# set by hand once the front door exists (scripts/ha.sh <env> wait-hostname
# names it).
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000

# Aurora (data-plane); its new VPC is the environment's VPC.
PG_ENGINE_VERSION=14.18
PG_INSTANCE_CLASS=r6g.large
PG_READERS=1
# Optional: a class of their own for the readers, which serve the API's
# queries while the writer only takes the node's writes. After a failover the
# instances have swapped roles (the larger one writes, the smaller one
# reads) until someone fails the cluster back.
# PG_READER_INSTANCE_CLASS=r8gd.2xlarge
# Optional: NAT gateways of that VPC. 1 (the default) serves both zones, so
# the loss of its zone cuts the other zone's tasks off from the internet;
# 2 gives each zone its own, for the price of a second gateway.
# NAT_GATEWAYS=2

# Core cells, "<cellId>:<zone>". The first is the writer when the environment
# is created; afterwards the lease moves between them (autoPromote).
CELLS="a:us-east-1a b:us-east-1b"
CELL_INSTANCE_TYPE=m6i.xlarge
CELL_DATA_GIB=300
SNAPSHOT_BUCKET=example-snapshots    # where a new cell finds the network's snapshots
SNAPSHOT_SOURCE=latest               # may be empty: a cell then syncs from the first block
# The vault the node key lives in, under the OAuth client below.
VAULT_URL=https://vault.example.com:8093/strato/v2.3

# Created by hand before the first run (Secrets Manager):
#   OAUTH_SECRET   JSON {discoveryUrl, clientId, clientSecret}: the node's OAuth
#                  client, with https://<NODE_HOSTNAME>/* among its redirect URIs
#   BACKEND_SECRET JSON of the app backend's keys; optional, empty leaves them unset
OAUTH_SECRET=ha-example/oauth
BACKEND_SECRET=ha-example/app/backend
# Exactly the keys BACKEND_SECRET holds (ECS refuses a task whose secret lacks
# a key it maps), separated by single spaces.
BACKEND_SECRET_KEYS="RPC_URL_SEPOLIA SENDGRID_API_KEY"

API_DESIRED_COUNT=2
APP_DESIRED_COUNT=2

# Traces, collector configs and alarms. Grafana runs on the first cell; these
# are the OAuth groups that may administer and view it (either may be empty).
OBSERVABILITY=true
GRAFANA_ADMIN_GROUPS=grafana-admins
GRAFANA_VIEWER_GROUPS=grafana-viewers

# Optional: the partner referrals service the app backend reports to, and the
# Secrets Manager name of that service's internal key. Both or neither.
# PARTNER_REFERRALS_URL=https://partner-referrals.example.com
# PARTNER_INTERNAL_KEY_SECRET=partner-referrals/internal-key

# Optional: the app UI's analytics, written into its config.js (the browser
# reads them, so they are not secrets). POSTHOG_HOST defaults to PostHog's US
# cloud. With none of them the UI runs no analytics.
# POSTHOG_KEY=phc_exampleProjectKey
# POSTHOG_HOST=https://us.i.posthog.com
# GOOGLE_ANALYTICS_ID=G-EXAMPLE123

# Optional: minutes to wait for a cell to follow the chain (default 360). The
# caller's environment may set it too.
# READY_TIMEOUT_MINUTES=360
