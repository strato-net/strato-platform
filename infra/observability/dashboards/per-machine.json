{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_CLOUDWATCH",
      "label": "CloudWatch",
      "type": "datasource",
      "pluginId": "cloudwatch"
    },
    {
      "name": "DS_XRAY",
      "label": "X-Ray",
      "type": "datasource",
      "pluginId": "grafana-x-ray-datasource"
    }
  ],
  "uid": "strato-per-machine",
  "title": "STRATO Per Machine",
  "tags": [
    "strato",
    "hosts"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${DS_CLOUDWATCH}"
        },
        "query": "dimension_values(default,CWAgent,mem_used_percent,InstanceId)",
        "refresh": 2,
        "includeAll": false
      },
      {
        "name": "proc",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(strato_rts_live_bytes, name)",
        "refresh": 2,
        "includeAll": true,
        "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU (percent active / iowait / steal)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "cpu_usage_active",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "cpu_usage_active"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "cpu_usage_iowait",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "cpu_usage_iowait"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "cpu_usage_steal",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "cpu_usage_steal"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory used percent",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "mem_used_percent",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "mem_used_percent"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Disk used percent",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "disk_used_percent",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "disk_used_percent"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Disk IOPS (reads / writes)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "diskio_reads",
          "statistic": "Sum",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "diskio_reads"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "diskio_writes",
          "statistic": "Sum",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "diskio_writes"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk throughput (bytes)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "diskio_read_bytes",
          "statistic": "Sum",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "diskio_read_bytes"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "diskio_write_bytes",
          "statistic": "Sum",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "diskio_write_bytes"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network (bytes in / out)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "net_bytes_recv",
          "statistic": "Sum",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "net_bytes_recv"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "CWAgent",
          "metricName": "net_bytes_sent",
          "statistic": "Sum",
          "period": "60",
          "dimensions": {
            "InstanceId": "$instance"
          },
          "region": "default",
          "label": "net_bytes_sent"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RTS live heap per process",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "strato_rts_live_bytes{name=~\"$proc\"}",
          "legendFormat": "{{name}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "RTS GC CPU share",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(strato_rts_gc_cpu_ns{name=~\"$proc\"}[5m]) / rate(strato_rts_cpu_ns{name=~\"$proc\"}[5m])",
          "legendFormat": "{{name}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Process metrics endpoints up",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"strato-.*|vm-runner|slipstream|ethereum-discover|core-api|nginx\"}",
          "legendFormat": "{{job}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    }
  ]
}