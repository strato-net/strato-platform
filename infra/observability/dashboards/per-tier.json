{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    },
    {
      "name": "DS_CLOUDWATCH",
      "label": "CloudWatch",
      "type": "datasource",
      "pluginId": "cloudwatch"
    },
    {
      "name": "DS_XRAY",
      "label": "X-Ray",
      "type": "datasource",
      "pluginId": "grafana-x-ray-datasource"
    }
  ],
  "uid": "strato-per-tier",
  "title": "STRATO Per Tier",
  "tags": [
    "strato",
    "tiers"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "env",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(strato_best_block_number, env)",
        "refresh": 2,
        "includeAll": false
      },
      {
        "name": "aurora",
        "type": "textbox",
        "label": "Aurora cluster id",
        "query": "strato-testnet"
      },
      {
        "name": "bus",
        "type": "textbox",
        "label": "MSK cluster name",
        "query": "strato-bus-testnet"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Edge requests per second by status class",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(nginx_http_requests_total{env=\"$env\"}[5m]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Edge p50 / p95 / p99 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(nginx_http_request_duration_seconds_bucket{env=\"$env\"}[5m])))",
          "legendFormat": "p{{le}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(nginx_http_request_duration_seconds_bucket{env=\"$env\"}[5m])))",
          "legendFormat": "p{{le}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(nginx_http_request_duration_seconds_bucket{env=\"$env\"}[5m])))",
          "legendFormat": "p{{le}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Edge 5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nginx_http_requests_total{env=\"$env\",status=~\"5..\"}[5m])) / sum(rate(nginx_http_requests_total{env=\"$env\"}[5m]))",
          "legendFormat": "5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Edge open connections",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nginx_http_connections{env=\"$env\"}",
          "legendFormat": "{{state}} {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Aurora replica lag (ms)",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "AWS/RDS",
          "metricName": "AuroraReplicaLagMaximum",
          "statistic": "Maximum",
          "period": "60",
          "dimensions": {
            "DBClusterIdentifier": "$aurora"
          },
          "region": "default",
          "label": "AuroraReplicaLagMaximum"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Aurora connections / CPU",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "AWS/RDS",
          "metricName": "DatabaseConnections",
          "statistic": "Maximum",
          "period": "60",
          "dimensions": {
            "DBClusterIdentifier": "$aurora"
          },
          "region": "default",
          "label": "DatabaseConnections"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "statistic": "Maximum",
          "period": "60",
          "dimensions": {
            "DBClusterIdentifier": "$aurora"
          },
          "region": "default",
          "label": "CPUUtilization"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Bus consumer lag by group",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "AWS/Kafka",
          "metricName": "SumOffsetLag",
          "statistic": "Maximum",
          "period": "60",
          "dimensions": {
            "Cluster Name": "$bus",
            "Consumer Group": "*"
          },
          "region": "default",
          "label": "SumOffsetLag"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Bus bytes in / out per broker",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${DS_CLOUDWATCH}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "AWS/Kafka",
          "metricName": "BytesInPerSec",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "Cluster Name": "$bus",
            "Broker ID": "*"
          },
          "region": "default",
          "label": "BytesInPerSec"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${DS_CLOUDWATCH}"
          },
          "namespace": "AWS/Kafka",
          "metricName": "BytesOutPerSec",
          "statistic": "Average",
          "period": "60",
          "dimensions": {
            "Cluster Name": "$bus",
            "Broker ID": "*"
          },
          "region": "default",
          "label": "BytesOutPerSec"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "ECS task CPU / memory utilised (sidecar)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "ecs_task_cpu_utilized{env=\"$env\"}",
          "legendFormat": "{{__name__}} {{aws_ecs_task_family}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "ecs_task_memory_utilized{env=\"$env\"}",
          "legendFormat": "{{__name__}} {{aws_ecs_task_family}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    }
  ]
}