pipeline {
  agent {
    label "test"
  }
  environment {
    PATH = "/home/ubuntu/.local/bin:${env.PATH}"
  }
  stages {
    stage('Prepare') {
      steps {
        sh 'git fetch --tags'
        sh 'git fetch origin develop --quiet'
        script {
          // A tag build (the job's "Discover tags" behaviour: release and rc tags)
          // publishes the tagged images and is never skipped as "same as develop".
          if (!env.TAG_NAME && env.BRANCH_NAME != 'develop' && sh(script: 'git diff --quiet origin/develop...HEAD', returnStatus: true) == 0) {
            currentBuild.result = 'NOT_BUILT'
            currentBuild.description = "Skipped - no changes vs develop"
            error('No changes compared to develop, skipping build.')
          }
        }
        wrap([$class: 'BuildUser']) {
          script {
            BUILD_USER=''
            try {
              BUILD_USER="${BUILD_USER_FIRST_NAME}"
            } catch (Exception e) {
              BUILD_USER="github"
            }
            MAIN_AGENT_NAME="${env.NODE_NAME}"
            currentBuild.description = "${MAIN_AGENT_NAME} //${BUILD_USER}"

            lib = load("${env.WORKSPACE}/pipelines/Jenkinsfile.library")
          }
        }
        sh '''#!/bin/bash -le
          # Find the previous deployment's node directory before bringing it down.
          # strato-ps prints either "######## STRATO Status: <dir>" (running)
          # or "STRATO is not running (<network> node at <dir>)" (stopped).
          PREV_NODE_DIR=$(strato-ps 2>/dev/null | sed -n \
            -e 's|^######## STRATO Status: ||p' \
            -e 's|^STRATO is not running (.* node at \\(.*\\))$|\\1|p' \
            | head -1) || true
          echo "Previous node directory: ${PREV_NODE_DIR:-<none>}"

          strato-down || true
          pkill convoke || true
          # Node processes a dead convoke left behind (an earlier build whose
          # terminal went away) keep the ports: kill them by name as well.
          pkill -f '^(ethereum-discover|strato-p2p|strato-sequencer|vm-runner|strato-indexer|slipstream|strato-network-monitor|strato-api|ethereum-jsonrpc|blockapps-vault-wrapper-server|strato-ingest|vm-query)( |$)' || true
          docker rm -f $(docker ps -aq) || true
          docker system prune -f || true
          docker volume prune -fa || true
          # Wipe the previous node directory, keeping logs/ and the generated configs, for debugging/reference
          if [ -n "$PREV_NODE_DIR" ] && [ -d "$PREV_NODE_DIR" ]; then
            sudo find "$PREV_NODE_DIR" -mindepth 1 -maxdepth 1 \
              ! -name logs ! -name docker-compose.yml ! -name commands.txt \
              -exec rm -rf {} + || true
          fi
          # Clean up node data from previous builds
          sudo rm -rf mynode || true
        '''
      }
    }

    stage('Build') {
      steps {
        sh 'rm -rf .docker-work'
        sh "git checkout BUILD_METADATA"
        sh 'make'

        // Build central services
        // Need to clean sentinels here again in order for image tags to match what will be added in the docker-compose - TODO: find out why
        // TODO: replace vault-wrapper and highway make-targets with ones that don't rely on build_common_docker (should depend on build_common instead)
        // strato_docker, app-nginx and history are not in `make local` (a developer's
        // node runs its processes on the host and no app tier) but are published.
        sh 'make strato_docker app-nginx history vault-wrapper vault-nginx bridge bridge-nginx bridge-eab bridge-eab-nginx oracle highway highway-nginx docker-compose'
      }
    }

    stage('Deploy') {

      steps {
        
        // Deploy services
        dir ('bootstrap-docker') {
          // Copy .pem and .key for SSL
           sh 'cp /home/ubuntu/letsencrypt-ssl/server.pem ssl/certs/'
           sh 'cp /home/ubuntu/letsencrypt-ssl/server.key ssl/private/'
          
          sh 'cp ../docker-compose.vault.yml .'
          sh 'cp ../docker-compose.highway.yml .'
          script {
            lib.spinUpVault()
            lib.replaceServerPortsDocker()
            lib.spinUpFileServer()
            // TODO: deploy the local bridge server (url fed to the node)
            // TODO: deploy the oracle and payment servers
          }
        }
        
        // TODO: use strato-login programmatically here (script needs to be updated to support) - currently using the manually predefined oauth credentials on the test machines
        /*
        withCredentials([
          usernamePassword(credentialsId: 'keycloak-strato-devel-dev-client', passwordVariable: 'KEYCLOAK_STRATODEVEL_DEV_SECRET', usernameVariable: 'KEYCLOAK_STRATODEVEL_DEV_ID'),
        ]) {
          OAUTH_DISCOVERY_URL='https://keycloak.blockapps.net/auth/realms/strato-devel/.well-known/openid-configuration' \
            OAUTH_CLIENT_ID='${KEYCLOAK_STRATODEVEL_DEV_ID}' \
            OAUTH_CLIENT_SECRET='${KEYCLOAK_STRATODEVEL_DEV_SECRET}' \
            strato-login --force
        }
        */
        
        // TODO: switch to using SSL (add --sslDir='/home/ubuntu/letsencrypt-ssl', (also update check_availability function to use port 443)
        writeFile file: "run.sh", text: """#!/bin/bash
          export PATH
          strato-up mynode \\
            --network=helium \\
            --nodeHost=\$(</host) \\
            --vaultUrl=https://\$(</host):8093/strato/v2.3 \\
            --fileServerUrl=https://\$(</host):44300/highway \\
            --sslDir='/home/ubuntu/letsencrypt-ssl' \\
            --jsonrpc
        """
        sh 'chmod +x run.sh'
        withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
          sh './run.sh'
        }

        sh 'docker ps'
        script {
          lib.checkNodeAvailability(443)
        }
      }
    }

    stage('Test & Push') {
      parallel {
        // The ECR services and the node images go to different registries; the
        // two pushes run side by side. Each uses its own docker config so the
        // concurrent logins do not race on ~/.docker/config.json.
        stage('Push to ECR') {
          steps {
            withCredentials([
                usernamePassword(credentialsId: 'aws-ecr-write-access-account', passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID'),
            ]) {
              sh '''#!/bin/bash -le
                set -x
                export DOCKER_CONFIG=$(mktemp -d)
                AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} AWS_DEFAULT_REGION="us-east-1" aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin 406773134706.dkr.ecr.us-east-1.amazonaws.com
                # ECR repositories have immutable tags: skip tags that already exist instead of failing the build
                ./scripts/docker-push-ecr.sh \
                  -f docker-compose.vault.push.yml \
                  -f docker-compose.highway.push.yml \
                  -f docker-compose.bridge.push.yml \
                  -f docker-compose.bridge-eab.push.yml 2>&1
                rm -rf "$DOCKER_CONFIG"
              '''
            }

            // Push docker-compose files to Jenkins artifacts and AWS S3
            archiveArtifacts artifacts: "docker-compose.vault.yml, docker-compose.highway.yml, docker-compose.bridge.yml, docker-compose.bridge-eab.yml, docker-compose.bridge-signer.yml"
            withCredentials([
                usernamePassword(credentialsId: 'block-apps-jenkins-s3',  passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID'),
            ]) {
              sh '''#!/bin/bash -le
                set -x
                version=$(cat VERSION)-$(git rev-parse --short=7 HEAD)
                AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} AWS_DEFAULT_REGION="us-east-1"
                aws s3 cp docker-compose.vault.yml s3://blockapps-build-artifacts/${version}/
                aws s3 cp docker-compose.highway.yml s3://blockapps-build-artifacts/${version}/
                aws s3 cp docker-compose.bridge.yml s3://blockapps-build-artifacts/${version}/
                aws s3 cp docker-compose.bridge-eab.yml s3://blockapps-build-artifacts/${version}/
                aws s3 cp docker-compose.bridge-signer.yml s3://blockapps-build-artifacts/${version}/
              '''
            }
          }
        }

        stage('Push to GHCR') {
          steps {
            withCredentials([
                usernamePassword(credentialsId: 'ghcr-cd-blockapps', passwordVariable: 'GHCR_TOKEN', usernameVariable: 'GHCR_USER'),
            ]) {
              sh '''#!/bin/bash -le
                set -x
                export DOCKER_CONFIG=$(mktemp -d)
                echo "$GHCR_TOKEN" | docker login ghcr.io -u "$GHCR_USER" --password-stdin
                make push-node-images 2>&1
                # The EAB bridge images go to ECR (the stage above) and here as well.
                make push-bridge-eab-images 2>&1
                # A release or rc tag build also publishes strato:<tag>, the alias a
                # release checkout and strato-up --prebuilt=<tag> resolve.
                if [[ -n "${TAG_NAME:-}" ]]; then make push-release-alias RELEASE_TAG="$TAG_NAME" 2>&1; fi
                rm -rf "$DOCKER_CONFIG"
              '''
            }
          }
        }

        stage('Node Status') {
          steps{
            script{
              lib.checkNodeStatusHealth()
              lib.checkNodeIsGettingBlocks()
            }
          }
        }
        
        stage('Contract tests') {
          steps {
            script {
              def WORKDIR = pwd()
              catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                sh """#!/bin/bash -lex
                  find app/contracts/tests -name '*.test.sol' -print0 | xargs -0 -I {} sh -c 'echo "Running test: {}" && cd "\$(dirname "{}")" && $WORKDIR/.docker-work/usr/local/bin/solid-vm-cli test "\$(basename "{}")"'
                """
              }
            }
          }
        }

        stage('SMD tests') {
          steps{
            sh '''#!/bin/bash -le
              set -x
              echo 'Running SMD tests'
              cd smd-ui
              docker build --target test .
            '''
          }
        }
      }
    }
  }

  post {
    always {
      sh 'rm -rf .docker-work'
      archiveArtifacts artifacts: 'mynode/logs/**', fingerprint: true, allowEmptyArchive: true
    }

    success {
      slackSend (
        color: 'good',
        message: "Build Successful: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL}) on node ${env.NODE_NAME}"
      )
    }

    failure {
      slackSend (
        color: 'danger',
        message: "Build failed: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL} on node ${env.NODE_NAME})"
      )


      script {
        if (env.BRANCH_NAME == 'develop') {
          slackSend(
              channel: '#engineering',
              color: 'danger',
              message: "Develop branch build failed: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL} on node ${env.NODE_NAME})"
          )
        }
      }
    }
  }
}
