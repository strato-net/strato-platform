pipeline {
  agent {
    label "testsync1"
  }
  options { disableConcurrentBuilds() }
  triggers {
    cron('H */3 * * *')
  }
  environment {
    PATH = "/home/ubuntu/.local/bin:${env.PATH}"
    // Public, read-only snapshot bucket; writes use the block-apps-jenkins-s3 IAM user.
    STRATO_SNAPSHOT_BUCKET = "strato-snapshots"
    AWS_DEFAULT_REGION = "us-east-1"
  }
  stages {
    stage('Prepare') {
      steps {
        script {
          lib = load("${env.WORKSPACE}/pipelines/Jenkinsfile.library")
        }
        sh '''#!/bin/bash -le
          strato-down mynode || true
          pkill convoke || true
          docker rm -f $(docker ps -aq) || true
          docker system prune -f || true
          docker volume prune -fa || true
          sudo rm -rf mynode || true
        '''
      }
    }

    stage('Build') {
      steps {
        sh 'rm -rf .docker-work'
        sh "git checkout BUILD_METADATA"
        sh 'make'
      }
    }

    // Deploy on helium (testnet), measure sync time, then snapshot + publish.
    stage('Helium Sync + Snapshot') {
      steps {
        deployAndSync('helium', 'Testnet')
      }
    }

    // Deploy on upquark (mainnet), measure sync time, then snapshot + publish.
    stage('Upquark Sync + Snapshot') {
      steps {
        deployAndSync('upquark', 'Mainnet')
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'mynode/logs/**', fingerprint: true, allowEmptyArchive: true
      sh '''#!/bin/bash -le
        strato-down mynode || true
        pkill convoke || true
      '''
    }
    success {
      slackSend (
          color: 'good',
          message: "Build Successful: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
      )
    }

//    failure {
//      slackSend (
//          color: 'danger',
//          message: "Build failed: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
//      )
//      slackSend(
//          channel: '#engineering',
//          color: 'danger',
//          message: "Sync test build failed: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
//      )
//    }

    fixed {
      slackSend(
          channel: '#engineering',
          color: 'good',
          message: "Sync test build recovered: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
      )
    }
  }
}

// Build-and-strato-up deploy for a single network: start the node with
// strato-up (using the network's default public vault and file server), wait
// for it to become available and sync, push CloudWatch metrics, then create
// and publish a snapshot. Cleanup is handled by the leading block below (on
// the next network's run) and by the post{always} teardown.
def deployAndSync(String network, String metricNamespacePrefix) {
  script {
    // Clean any prior node state before this network's run.
    sh '''#!/bin/bash -le
      strato-down mynode || true
      pkill convoke || true
      docker rm -f $(docker ps -aq) || true
      docker system prune -f || true
      docker volume prune -fa || true
      sudo rm -rf mynode || true
    '''

    // Start the node from genesis using strato-up. Uses the network's default
    // public vault and file server, so no local vault/highway deployment is
    // needed.
    writeFile file: "run.sh", text: """#!/bin/bash
      export PATH
      strato-up mynode \\
        --network=${network} \\
        --nodeHost=\$(</host) \\
        --sslDir='/home/ubuntu/letsencrypt-ssl'
    """
    sh 'chmod +x run.sh'
    withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
      sh './run.sh'
    }
    sh 'docker ps'

    // Confirm the node is reachable, then measure sync time.
    lib.checkNodeAvailability(443)
    def timeStart = System.currentTimeMillis()
    lib.waitLocalNodeIsSynced()
    def syncTimeSec = (System.currentTimeMillis() - timeStart) / 1000
    def syncTimeMin = syncTimeSec / 60
    def blocksTotal = Integer.parseInt(sh(
        script: "docker exec strato-nginx-1 curl -s apex:3009/status | jq -r .lastBlock.number",
        returnStdout: true
    ).trim())
    def syncTimePerBlockSec = blocksTotal == 0 ? 0 : (syncTimeSec / blocksTotal)

    sh """
      aws cloudwatch put-metric-data \
        --namespace '${metricNamespacePrefix}/Synctest/TimeMins' \
        --metric-name '${metricNamespacePrefix}SyncTime' \
        --value ${syncTimeMin} \
        --unit 'Seconds' \
        --region 'us-east-1'
    """
    sh """
      aws cloudwatch put-metric-data \
        --namespace '${metricNamespacePrefix}/Synctest/TimePerBlockSec' \
        --metric-name '${metricNamespacePrefix}SyncTimePerBlock' \
        --value ${syncTimePerBlockSec} \
        --unit 'Seconds' \
        --region 'us-east-1'
    """

    // On successful sync, create and publish a snapshot for this network.
    withCredentials([
      usernamePassword(credentialsId: 'block-apps-jenkins-s3', passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID'),
    ]) {
      sh """#!/bin/bash -le
        set -x
        export AWS_DEFAULT_REGION=us-east-1
        ./scripts/create-and-publish-snapshot.sh \
          --node-dir mynode \
          --network ${network} \
          --bucket ${STRATO_SNAPSHOT_BUCKET} \
          --wait-timeout 600 \
          --strict-layers
      """
    }
  }
}
