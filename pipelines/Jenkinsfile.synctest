pipeline {
  agent {
    label "testsync1"
  }
  options { disableConcurrentBuilds() }
  triggers {
    cron('H */4 * * *')
  }
  environment {
    PATH = "/home/ubuntu/.local/bin:${env.PATH}"
    // Public, read-only snapshot bucket; writes use the block-apps-jenkins-s3 IAM user.
    STRATO_SNAPSHOT_BUCKET = "strato-snapshots"
    AWS_DEFAULT_REGION = "us-east-1"
  }
  stages {
    stage('Prepare') {
      steps {
        script {
          lib = load("${env.WORKSPACE}/pipelines/Jenkinsfile.library")
        }
        reclaimDisk()
      }
    }

    stage('Build') {
      steps {
        sh 'rm -rf .docker-work'
        sh "git checkout BUILD_METADATA"
        sh 'make'
      }
    }

    // Deploy on helium (testnet), measure sync time, then snapshot + publish.
    stage('Helium Sync + Snapshot') {
      steps {
        deployAndSync('helium', 'Testnet')
      }
    }

    // Deploy on upquark (mainnet), measure sync time, then snapshot + publish.
    stage('Upquark Sync + Snapshot') {
      steps {
        deployAndSync('upquark', 'Mainnet')
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'mynode/logs/**', fingerprint: true, allowEmptyArchive: true
      sh '''#!/bin/bash -le
        strato-down mynode || true
        pkill convoke || true
        # Node state and snapshot staging are the big workspace consumers
        # (restored state ~10GB, archive ~3.5GB); do not leave them between runs.
        docker rm -f $(docker ps -aq) 2>/dev/null || true
        docker volume prune -fa || true
        sudo rm -rf mynode || true
        rm -rf snapshot-out .snapshot-work .snapshot-downloads || true
        rm -rf /tmp/tmp.* || true
        df -h / | tail -1
      '''
    }
    success {
      slackSend (
          color: 'good',
          message: "Build Successful: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
      )
    }

//    failure {
//      slackSend (
//          color: 'danger',
//          message: "Build failed: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
//      )
//      slackSend(
//          channel: '#engineering',
//          color: 'danger',
//          message: "Sync test build failed: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
//      )
//    }

    fixed {
      slackSend(
          channel: '#engineering',
          color: 'good',
          message: "Sync test build recovered: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL})"
      )
    }
  }
}

// Stop the node and drop the state it leaves behind, WITHOUT touching images.
// Safe to call between stages: `docker system prune -f` only collects dangling
// (untagged) images, so the locally-built component images the next strato-up
// needs survive. Never add `-a` here -- these images are built locally with
// content-hash tags and are not pullable from a registry, so removing them
// mid-run would break the following stages.
def cleanNodeState() {
  sh '''#!/bin/bash -le
    strato-down mynode || true
    pkill convoke || true
    docker rm -f $(docker ps -aq) 2>/dev/null || true
    docker system prune -f || true
    docker volume prune -fa || true
    sudo rm -rf mynode || true
    rm -rf snapshot-out .snapshot-work .snapshot-downloads || true
    rm -rf /tmp/tmp.* || true
  '''
}

// Full disk reclaim. Only safe in Prepare, i.e. before the Build stage rebuilds
// what it removes.
//
// This job builds ~15 component images per run, each tagged
// <name>:<VERSION>-<content-hash>, and the Makefile skips a build when that tag
// already exists. Those images are tagged, so they are never "dangling" and
// plain `docker system prune -f` never reclaimed them: every 4h run whose code
// hashes changed left another full set behind, growing container storage without
// bound (60GB observed). `-a` collects every image not used by a running
// container, and `builder prune` drops the BuildKit cache, which `system prune`
// only trims when dangling.
//
// Trade-off: each run now rebuilds all component images instead of reusing
// unchanged ones. That cost is small next to the multi-hour from-genesis syncs
// this job spends most of its time in, and the Haskell build cache (~/.stack,
// the genuinely expensive part) lives outside Docker and is untouched.
def reclaimDisk() {
  cleanNodeState()
  sh '''#!/bin/bash -le
    docker system prune -af --volumes || true
    docker builder prune -af || true
    echo "=== disk after reclaim ==="
    df -h /
    docker system df || true
  '''
}

// Build-and-strato-up deploy for a single network: start the node with
// strato-up (using the network's default public vault and file server), wait
// for it to become available and sync, push CloudWatch metrics, then create
// and publish a snapshot. Cleanup is handled by the leading block below (on
// the next network's run) and by the post{always} teardown.
def deployAndSync(String network, String metricNamespacePrefix) {
  script {
    // Clean any prior node state before this network's run.
    cleanNodeState()

    // Start the node from genesis using strato-up. Uses the network's default
    // public vault and file server, so no local vault/highway deployment is
    // needed.
    //
    // NOTE: do NOT lower kafka retention (--kafkaLogRetention*) on this node.
    // During a from-genesis sync the sequencer runs far ahead of the VM, so
    // vm-runner's unconsumed vm_tasks backlog is essentially the whole topic;
    // any retention cap the topic outgrows deletes unconsumed segments and
    // vm-runner dies with OffsetOutOfRange mid-sync. Shrinking the kafka
    // payload happens at snapshot time instead: strato-snapshot create prunes
    // the consumed history behind the committed consumer offsets.
    //
    // The smaller segment size below is safe (it deletes nothing): it only
    // makes the broker roll log files more often, so the snapshot-time prune
    // can reclaim consumed history at fine granularity -- whole segments are
    // the deletion unit, and the default 1GiB segments never roll on these
    // topics.
    writeFile file: "run.sh", text: """#!/bin/bash
      export PATH
      strato-up mynode \\
        --network=${network} \\
        --nodeHost=\$(</host) \\
        --sslDir='/home/ubuntu/letsencrypt-ssl' \\
        --kafkaLogSegmentBytes=67108864
    """
    sh 'chmod +x run.sh'
    withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
      sh './run.sh'
    }
    sh 'docker ps'

    // Confirm the node is reachable, then measure sync time.
    lib.checkNodeAvailability(443)
    def timeStart = System.currentTimeMillis()
    lib.waitLocalNodeIsSynced()
    def syncTimeSec = (System.currentTimeMillis() - timeStart) / 1000
    def syncTimeMin = syncTimeSec / 60
    def blocksTotal = Integer.parseInt(sh(
        script: "docker exec strato-nginx-1 curl -s apex:3009/status | jq -r .lastBlock.number",
        returnStdout: true
    ).trim())
    def syncTimePerBlockSec = blocksTotal == 0 ? 0 : (syncTimeSec / blocksTotal)

    sh """
      aws cloudwatch put-metric-data \
        --namespace '${metricNamespacePrefix}/Synctest/TimeMins' \
        --metric-name '${metricNamespacePrefix}SyncTime' \
        --value ${syncTimeMin} \
        --unit 'Seconds' \
        --region 'us-east-1'
    """
    sh """
      aws cloudwatch put-metric-data \
        --namespace '${metricNamespacePrefix}/Synctest/TimePerBlockSec' \
        --metric-name '${metricNamespacePrefix}SyncTimePerBlock' \
        --value ${syncTimePerBlockSec} \
        --unit 'Seconds' \
        --region 'us-east-1'
    """

    // On successful sync, create a snapshot for this network but DO NOT publish
    // yet. We validate the archive by restoring a fresh node from it, and only
    // publish if that succeeds -- so a bad snapshot never overwrites 'latest'.
    def snapshotDir = "${env.WORKSPACE}/snapshot-out"
    sh "rm -rf ${snapshotDir} && mkdir -p ${snapshotDir}"
    def createOut = sh(returnStdout: true, script: """#!/bin/bash -le
      set -x
      ./scripts/create-and-publish-snapshot.sh \
        --node-dir mynode \
        --network ${network} \
        --bucket ${STRATO_SNAPSHOT_BUCKET} \
        --output-dir ${snapshotDir} \
        --wait-timeout 600 \
        --strict-layers \
        --no-publish
    """).trim()
    def archivePath = createOut.readLines().find { it.startsWith('SNAPSHOT_ARCHIVE=') }?.substring('SNAPSHOT_ARCHIVE='.length())?.trim()
    if (!archivePath) {
      error("Could not determine created snapshot archive path from create output")
    }

    // Validate the archive by restoring a fresh node from the local file and
    // confirming it resumes from the snapshot height (not genesis).
    verifySnapshotRestore(network, archivePath, blocksTotal)

    // Validation passed: publish the validated archive (uploads it and updates
    // the 'latest' alias for the network).
    withCredentials([
      usernamePassword(credentialsId: 'block-apps-jenkins-s3', passwordVariable: 'AWS_SECRET_ACCESS_KEY', usernameVariable: 'AWS_ACCESS_KEY_ID'),
    ]) {
      sh """#!/bin/bash -le
        set -x
        export AWS_DEFAULT_REGION=us-east-1
        ./scripts/create-and-publish-snapshot.sh \
          --network ${network} \
          --bucket ${STRATO_SNAPSHOT_BUCKET} \
          --publish-only ${archivePath}
      """
    }

    sh "rm -rf ${snapshotDir}"
  }
}

// Restore a fresh node from a local snapshot archive and confirm it comes up and
// resumes from at/near the snapshot block height. Runs BEFORE the archive is
// published, so an unusable snapshot fails the build without touching 'latest'.
def verifySnapshotRestore(String network, String archivePath, def snapshotBlock) {
  script {
    // Start from a clean node directory.
    cleanNodeState()

    writeFile file: "run-restore.sh", text: """#!/bin/bash
      export PATH
      strato-up mynode \\
        --network=${network} \\
        --nodeHost=\$(</host) \\
        --sslDir='/home/ubuntu/letsencrypt-ssl' \\
        --snapshot-source='${archivePath}'
    """
    sh 'chmod +x run-restore.sh'
    withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
      sh './run-restore.sh'
    }
    sh 'docker ps'

    // Node must come up and serve metadata.
    lib.checkNodeAvailability(443)

    // The restored node must start at/above the snapshot height, proving it
    // resumed from snapshot state rather than syncing from genesis. Allow a
    // small margin below the snapshot block for indexer settling.
    def restoredBlock = Integer.parseInt(sh(
        script: "docker exec strato-nginx-1 curl -s apex:3009/status | jq -r .lastBlock.number",
        returnStdout: true
    ).trim())
    echo "Restored node block: ${restoredBlock}, snapshot block: ${snapshotBlock}"
    if (restoredBlock < (snapshotBlock as int) - 100) {
      error("Restored node block (${restoredBlock}) is far below the snapshot height (${snapshotBlock}); restore likely failed")
    }

    // Tear the verification node down before moving on.
    sh '''#!/bin/bash -le
      strato-down mynode || true
      pkill convoke || true
    '''
  }
}
