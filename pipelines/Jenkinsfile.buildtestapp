pipeline {
  agent {
    label "testnet-buildtest-app"
  }
  environment {
    PATH = "~/.local/bin:${env.PATH}"
  }
  stages {
    
    stage('Prepare') {
      steps {
        sh '''#!/bin/bash -le
          docker system prune -fa || true
        '''
      }
    }
    
    stage('Build') {
      steps {
        sh 'rm -rf .docker-work'
        sh "git checkout BUILD_METADATA"
        script {
          sh '''#!/bin/bash -leo pipefail
            make app | tee make-app.log
          '''
          // Last line of `make app` is:
          //   strato-patch-app <node-dir> <OPTIONAL_PREFIX>mercata-backend:<TAG> <OPTIONAL_PREFIX>mercata-ui:<TAG>
          // Strip the `strato-patch-app <node-dir>` prefix so we keep just the two image args.
          env.PATCH_APP_IMAGES = sh(
            script: "tail -n 1 make-app.log | sed -E 's/^[[:space:]]*strato-patch-app[[:space:]]+[^[:space:]]+[[:space:]]+//'",
            returnStdout: true
          ).trim()
          echo "Captured patch-app image args: ${env.PATCH_APP_IMAGES}"
        }
      }
    }

    stage('Deploy to testnet-buildtest-app') {
      steps {
        withCredentials([
            usernamePassword(credentialsId: 'testnet-buildtest-client', passwordVariable: 'BUILDTEST_CLIENT_SECRET', usernameVariable: 'BUILDTEST_CLIENT_ID'),
            string(credentialsId: 'buildtest-rpc-url-sepolia', variable: 'BUILDTEST_RPC_URL_SEPOLIA'),
            string(credentialsId: 'buildtest-rpc-url-sepolia-fallback', variable: 'BUILDTEST_RPC_URL_SEPOLIA_FALLBACK'),
            string(credentialsId: 'buildtest-stripe-secret-key', variable: 'BUILDTEST_STRIPE_SECRET_KEY'),
            string(credentialsId: 'buildtest-stripe-publishable-key', variable: 'BUILDTEST_STRIPE_PUBLISHABLE_KEY'),
            string(credentialsId: 'buildtest-stripe-webhook-secret', variable: 'BUILDTEST_STRIPE_WEBHOOK_SECRET'),
            string(credentialsId: 'buildtest-onramp-hot-wallet-address', variable: 'BUILDTEST_ONRAMP_HOT_WALLET_ADDRESS'),
            usernamePassword(credentialsId: 'buildtest-bridge-admin', passwordVariable: 'BUILDTEST_BA_PASSWORD', usernameVariable: 'BUILDTEST_BA_USERNAME'),
        ]) {
          sh "strato-patch-app mynode ${env.PATCH_APP_IMAGES}"
          sh "strato-down"
          writeFile file: "run.sh", text: """#!/bin/bash
            export PATH
            RPC_URL_SEPOLIA='$BUILDTEST_RPC_URL_SEPOLIA' \\
                RPC_URL_SEPOLIA_FALLBACK='$BUILDTEST_RPC_URL_SEPOLIA_FALLBACK' \\
                STRIPE_SECRET_KEY='$BUILDTEST_STRIPE_SECRET_KEY' \\
                STRIPE_PUBLISHABLE_KEY='$BUILDTEST_STRIPE_PUBLISHABLE_KEY' \\
                STRIPE_WEBHOOK_SECRET='$BUILDTEST_STRIPE_WEBHOOK_SECRET' \\
                ONRAMP_HOT_WALLET_ADDRESS='$BUILDTEST_ONRAMP_HOT_WALLET_ADDRESS' \\
                BA_USERNAME='$BUILDTEST_BA_USERNAME' \\
                BA_PASSWORD='$BUILDTEST_BA_PASSWORD' \\
            strato-up mynode \\
              --network=helium \\
              --nodeHost='buildtest-app.testnet.strato.nexus' \\
              --sslDir='/home/ubuntu/letsencrypt-ssl/'
          """
          sh "chmod +x run.sh"
          
          withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
            sh "./run.sh"
          }
          script {
            def lib = load("${env.WORKSPACE}/pipelines/Jenkinsfile.library")
            // First check if blocks are flowing within the first 5 minutes
            lib.checkNodeIsGettingBlocks()
            // Then wait for the full sync
            lib.waitLocalNodeIsSynced()
          }
        }
      }
    }
  }

  post {
    success {
      slackSend(
          channel: '#engineering',
          color: 'good',
          message: "buildtest-app.testnet.strato.nexus was updated in place with app version from develop"
      )
    }
    failure {
      slackSend(
          channel: '#engineering',
          color: 'danger',
          message: "buildtest.testnet.strato.nexus has FAILED to be updated in place with app version from develop"
      )
    }
  }
}
