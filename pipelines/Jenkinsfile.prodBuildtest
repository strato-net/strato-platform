pipeline {
  agent {
    label "mainnet-build1"
  }
  options { disableConcurrentBuilds() }
  environment {
    PATH = "~/.local/bin:${env.PATH}"
  }
  stages {

    stage('Prepare') {
      steps {
        sh '''#!/bin/bash -le
          strato-down || true
          pkill -f convoke || true
          docker rm -f $(docker ps -aq) || true
          docker system prune -f || true
          docker volume prune -fa || true
          # Clean up node data from previous builds
          sudo rm -rf mynode || true
        '''
      }
    }

    stage('Build') {
      steps {
        sh 'rm -rf .docker-work'
        sh "git checkout BUILD_METADATA"
        sh 'make'
      }
    }

    stage('Deploy to Mainnet') {
      steps {
        sh "sudo cp /root/run.sh ./"
        sh "chmod +x run.sh"
        withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
          sh "./run.sh"
        }
        script {
          def lib = load("${env.WORKSPACE}/pipelines/Jenkinsfile.library")
          // First check if blocks are flowing within the first 5 minutes
          lib.checkNodeIsGettingBlocks()
          // Then wait for the full sync
          lib.waitLocalNodeIsSynced()
        }
      }
    }
  }

  post {
    //always {
    //  archiveArtifacts artifacts: 'mynode/logs/**', fingerprint: true, allowEmptyArchive: true
    //}
    success {
      slackSend(
          channel: '#engineering',
          color: 'good',
          message: "buildtest internal (mainnet) was redeployed from develop"
      )
    }
    failure {
      slackSend(
          channel: '#engineering',
          color: 'danger',
          message: "buildtest internal (mainnet) has failed to build or redeploy from develop"
      )
    }
  }
}
