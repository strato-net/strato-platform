pipeline {
  agent {
    label "testnet-build1"
  }
  options { disableConcurrentBuilds() }
  environment {
    PATH = "~/.local/bin:${env.PATH}"
  }
  stages {
    
    stage('Prepare') {
      steps {
        sh '''#!/bin/bash -le
          strato-down || true
          pkill -f convoke || true
          docker rm -f $(docker ps -aq) || true
          docker system prune -f || true
          docker volume prune -fa || true
          # Clean up node data from previous builds
          sudo rm -rf mynode || true
        '''
      }
    }
    
    stage('Build') {
      steps {
        sh 'rm -rf .docker-work'
        sh "git checkout BUILD_METADATA"
        sh 'make'
      }
    }

    stage('Deploy to Testnet') {
      steps {
        withCredentials([
            usernamePassword(credentialsId: 'testnet-buildtest-client', passwordVariable: 'BUILDTEST_CLIENT_SECRET', usernameVariable: 'BUILDTEST_CLIENT_ID'),
            string(credentialsId: 'buildtest-rpc-url-sepolia', variable: 'BUILDTEST_RPC_URL_SEPOLIA'),
            string(credentialsId: 'buildtest-rpc-url-sepolia-fallback', variable: 'BUILDTEST_RPC_URL_SEPOLIA_FALLBACK'),
        ]) {
          writeFile file: "run.sh", text: """#!/bin/bash
            export PATH
            RPC_URL_SEPOLIA='$BUILDTEST_RPC_URL_SEPOLIA' \\
                RPC_URL_SEPOLIA_FALLBACK='$BUILDTEST_RPC_URL_SEPOLIA_FALLBACK' \\
            strato-up mynode \\
              --network=helium \\
              --nodeHost='buildtest.testnet.strato.nexus' \\
              --sslDir='/home/ec2-user/cloudflare-ssl/'
          """
          sh "chmod +x run.sh"
          withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
            sh "./run.sh"
          }
          script {
            def lib = load("${env.WORKSPACE}/pipelines/Jenkinsfile.library")
            // First check if blocks are flowing within the first 5 minutes
            lib.checkNodeIsGettingBlocks()
            // Then wait for the full sync
            lib.waitLocalNodeIsSynced()
          }
        }
      }
    }
  }

  post {
    success {
      slackSend (
          color: 'good',
          message: "buildtest.testnet.strato.nexus was redeployed from develop. Build Successful: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL}) on node ${env.NODE_NAME}"
      )
      
      slackSend(
          channel: '#engineering',
          color: 'good',
          message: "buildtest.testnet.strato.nexus was redeployed from develop"
      )
    }
    failure {
      slackSend (
          color: 'danger',
          message: "buildtest.testnet.strato.nexus has failed to build or redeploy from develop. Build failed: Job '${env.JOB_NAME} [${env.BUILD_NUMBER}]' (${env.BUILD_URL} on node ${env.NODE_NAME})"
      )
      slackSend(
          channel: '#engineering',
          color: 'danger',
          message: "buildtest.testnet.strato.nexus has failed to build or redeploy from develop"
      )
    }
  }
}
