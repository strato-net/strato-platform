/**
 * Generate genesis-block.json
 * @return
 */
def generateGenesisBlock() {
  sh '''#!/bin/bash -le
    set -x
    cd bootstrap-docker
    nodeAddress=$(./strato --get-address)
    cd ..
    # TODO: run genesis-builder outside of Docker
    sudo docker cp ./strato/tools/genesis-builder strato-strato-1:/
    # Inject the nodeAddress into the validators.json file:
    sudo docker exec -e addr="${nodeAddress}" strato-strato-1 bash -c 'echo "[\"$addr\"]" > /genesis-builder/validators.json'
    sudo docker cp ./.docker-work/usr/local/bin/genesis-builder strato-strato-1:/usr/local/bin/
    sudo docker cp ./strato/tools/genesis-builder strato-strato-1:/
    sudo docker exec strato-strato-1 genesis-builder \\
        --input=/genesis-builder/genesis-block.tpl.json \\
        --validators=/genesis-builder/validators.json \\
        --admins=/genesis-builder/admins.json \\
        --output=/genesis-builder/genesis-block.json
    sudo docker cp strato-strato-1:/genesis-builder/genesis-block.json ./bootstrap-docker
  '''
}

/**
 * Register a STRATO key for a user
 */
def registerStratoUserKey(OAuthDiscoveryUrl, clientId, clientSecret, username='', password='', port='80') {
  
  def oauth_token_endpoint = sh(returnStdout: true, script: "curl --fail -s ${OAuthDiscoveryUrl} | jq -r .token_endpoint ").trim()
  sh "echo ${oauth_token_endpoint} > _oauth_token_endpoint_tmp"
  def client_b64string = sh(returnStdout: true, script: "echo -n '${clientId}:${clientSecret}' | base64 -w0").trim()
  def data_url_encoded = "--data-urlencode 'grant_type=client_credentials'"
  if (!username.isEmpty() && !password.isEmpty()) {
    data_url_encoded = "--data-urlencode 'grant_type=password' --data-urlencode 'username=${username}' --data-urlencode 'password=${password}'"
  }
  def user_token = sh(returnStdout: true, script: "curl --fail -s -X POST ${oauth_token_endpoint} -H 'Content-Type: application/x-www-form-urlencoded' -H 'Authorization: Basic ${client_b64string}' ${data_url_encoded} | jq -r .access_token ").trim()
  sh "echo ${user_token} > _user_token_tmp"
  sh "echo ${port} > _port_tmp"
  sh '''#!/bin/bash -le
      set -xe
      # make sure user is created (now or earlier):
      docker exec strato-nginx-1 curl --fail -H "Authorization: Bearer $(<_user_token_tmp)" -X POST "localhost:$(<_port_tmp)/strato/v2.3/key"
      userPubKey=$(docker exec strato-nginx-1 curl --fail -s -H "Authorization: Bearer $(<_user_token_tmp)" -H "Accept: application/json" "localhost:$(<_port_tmp)/strato/v2.3/key" | jq -r .pubkey)
  '''
}

/**
 * Test to see if a node can complete a full sync
 * Prereqs: this script assumes you already started up a strato node!
 * Keep in mind this script will not wipe the strato node at the end, 
 * nor will it post any txs to the blockchain. It simply passively checks
 * for a completed sync or for any potential failures along the way
 */
def runSyncTester() {
  sh '''#!/usr/bin/env bash
  counter=0
  # make sure started syncing (have 1+ active connections to peers)
  NUM_ACTIVE_PEERS=$(sudo docker exec strato-postgres-1 psql -U postgres -t -d eth -c "select count(ip) from p_peer where active_state > 0;" | tr -d "[:space:]")
  until [[ $NUM_ACTIVE_PEERS -gt 0 ]]
  do
      if (( $counter >= 120 )) ; then
          echo "Failure: STRATO node did not connect to any peers in 2 minutes. Something is preventing sync from starting"
          exit 3
      fi
      sleep 1
      NUM_ACTIVE_PEERS=$(sudo docker exec strato-postgres-1 psql -U postgres -t -d eth -c "select count(ip) from p_peer where active_state > 0;" | tr -d "[:space:]")
      counter=$((++counter))
  done

  WAIT_TIME=30
  STALLED_INTERVALS=0
  MAX_STALLED_INTERVALS=100

  LAST_VM_BLOCK_NUM=0
  LAST_SEQ_BLOCK_NUM=0

  METADATA=$(sudo ./strato --get-metadata)
  IS_SYNCED=$(jq -r .isSynced <<< ${METADATA})
  while [ "$IS_SYNCED" != true ]; do
      echo "**************************************"
      echo "$(date -u '+%Y-%m-%d %H:%M:%S'):"
      if [[ $(sudo docker ps | grep unhealthy) ]]; then
          echo "Failure: one or more docker containers became unhealthy during sync"
          exit 2
      fi
      STATUS=$(sudo docker exec strato-apex-1 curl -s -f http://localhost:3009/status )
      CUR_VM_BLOCK_NUM=$(jq -r .lastBlock.number <<< ${STATUS})
      CUR_SEQ_BLOCK_NUM=$(jq -r .pbftData.sequence_number <<< ${STATUS})
      echo "prev vm block #: ${LAST_VM_BLOCK_NUM}, cur vm block #: ${CUR_VM_BLOCK_NUM}"
      echo "prev seq block #: ${LAST_SEQ_BLOCK_NUM}, cur seq block #: ${CUR_SEQ_BLOCK_NUM}"
      if [[ $CUR_VM_BLOCK_NUM == $LAST_VM_BLOCK_NUM && $CUR_SEQ_BLOCK_NUM == $LAST_SEQ_BLOCK_NUM ]] ; then
          # VM and Sequencer not gone forward. Perhaps stalled
          if (( $STALLED_INTERVALS < $MAX_STALLED_INTERVALS )) ; then 
              STALLED_INTERVALS=$((++STALLED_INTERVALS))
          else
              echo "Failure: node stalled during sync; went $(( MAX_STALLED_INTERVALS * WAIT_TIME )) seconds without increasing block number"
              exit 1
          fi
      else
          STALLED_INTERVALS=0
      fi
      sleep $WAIT_TIME
      IS_SYNCED=$(sudo ./strato --get-metadata | jq -r .isSynced)
      LAST_VM_BLOCK_NUM=$CUR_VM_BLOCK_NUM
      LAST_SEQ_BLOCK_NUM=$CUR_SEQ_BLOCK_NUM
  done
  echo "Sync successful!"
  exit 0
'''
}

def checkNodeStatusHealth() {
  sh '''#!/bin/bash -le
    set -x
    STATUS=$(sudo docker exec strato-apex-1 curl -s -f http://localhost:3009/status )
    if [[ $(jq -r .healthData.healthChecks.health <<< ${STATUS}) != true ]]; then
      echo "Failure: STRATO Status could not be obtained or the STRATO health is not \"true\". If you don't see the output above - the /apex-api/status endpoint is probably not available."
      exit 1
    fi
  '''
}

def checkNodeIsGettingBlocks() {
  sh '''#!/bin/bash -l
    echo "Waiting for node to start syncing blocks..."
    counter=0
    while true; do
      BLOCK_NUM=$(docker exec strato-nginx-1 curl -s http://apex:3009/status | jq .lastBlock.number 2>/dev/null)
      # Strip quotes: "123" -> 123
      BLOCK_NUM_CLEAN=$(echo "$BLOCK_NUM" | tr -d '"')
      if [[ "$BLOCK_NUM_CLEAN" =~ ^[0-9]+$ ]] && [[ "$BLOCK_NUM_CLEAN" -gt 0 ]]; then
        echo "Node is syncing blocks (block #${BLOCK_NUM_CLEAN})"
        exit 0
      fi
      if [[ "$counter" -gt 300 ]]; then
        echo "Node did not sync any blocks within 5 minutes. Last response: ${BLOCK_NUM}"
        exit 1
      fi
      counter=$((counter+1))
      sleep 1
    done
  '''
}

def spinUpVault() {
  writeFile file: "run-vault.sh", text: """#!/bin/bash
  sudo \\
    ssl=true \\
    HTTPS_PORT=8093 \\
    INITIAL_OAUTH_DISCOVERY_URL='https://keycloak.blockapps.net/auth/realms/mercata/.well-known/openid-configuration' \\
    INITIAL_OAUTH_ISSUER='https://keycloak.blockapps.net/auth/realms/mercata' \\
    INITIAL_OAUTH_JWT_USERNAME_CLAIM='sub' \\
    PASSWORD=123 \\
    ./vault
  """
  sh 'chmod +x run-vault.sh'

  sh './run-vault.sh'
}

def spinUpFileServer() {
  withCredentials([
    string(credentialsId: 'DEV_EXT_STORAGE_S3_ACCESS_KEY_ID', variable:'DEV_EXT_STORAGE_S3_ACCESS_KEY_ID'),
    string(credentialsId: 'DEV_EXT_STORAGE_S3_SECRET_ACCESS_KEY', variable:'DEV_EXT_STORAGE_S3_SECRET_ACCESS_KEY'),
  ]) {
    writeFile file: "run-highway.sh", text: """#!/bin/bash
      sudo \\
        EXT_STORAGE_S3_ACCESS_KEY_ID='${DEV_EXT_STORAGE_S3_ACCESS_KEY_ID}' \\
        EXT_STORAGE_S3_SECRET_ACCESS_KEY='${DEV_EXT_STORAGE_S3_SECRET_ACCESS_KEY}' \\
        EXT_STORAGE_S3_BUCKET='mercata-dev-tests' \\
        ssl=true \\
        HIGHWAY_URL=https://\$(</host):44300 \\
        HTTPS_PORT=44300 \\
        HTTP_PORT=8000 \\
        ./highway
    """
  }

  sh 'chmod +x run-highway.sh'
  sh './run-highway.sh'
  sh 'docker ps'

  writeFile file: "check_availability_highway.sh", text: '''#!/bin/bash -le
    check_availability_highway() {
      counter=0
      until curl --silent --fail --location https://$(</host):44300/ping | jq . | grep 1
      do
        if [[ "$counter" -gt 120 ]]; then
          echo "Highway server took longer than 2 minutes to initialize! aborting."
          exit 73
        fi
        echo "waiting for Highway server health endpoint to be available through nginx"
        counter=$((counter+1))
        sleep 1
      done
      echo "Highway server health endpoint is available through nginx - node is running"
    }

    check_availability_highway
  '''
  sh 'chmod +x check_availability_highway.sh'
  sh './check_availability_highway.sh'
}

def checkNodeAvailability(port) {
  def protocol = port == 443 ? "https" : "http"
  writeFile file: "check_availability.sh", text: """#!/bin/bash -le
    check_availability() {
      counter=0
      until curl --silent --fail --location ${protocol}://\$(</host):${port}/health | jq .health | grep true
      do
        if [[ "\$counter" -gt 300 ]]; then
          echo "STRATO node took longer than 5 minutes to initialize! aborting."
          exit 73
        fi
        echo "waiting for STRATO health endpoint to be available through nginx"
        counter=\$((counter+1))
        sleep 1
      done
      echo "STRATO health endpoint is available through nginx - node is running"
    }

    check_availability
  """
  sh 'chmod +x check_availability.sh'
  sh './check_availability.sh'
}

def replaceServerPortsDocker() {
  writeFile file: "replace_server_ports_docker.sh", text: '''#!/bin/bash
    if [ -z "$1" ]; then
      echo "Please provide the path to your docker-compose file as an argument."
      exit 1
    fi

    sed -i "s/PORT:-443/PORT:-44300/" $1
    sed -i "s/PORT:-80/PORT:-8000/" $1

    if [ $? -ne 0 ]; then
      echo "Error occurred while modifying the file."
      exit 1
    fi
  '''

  sh 'chmod +x replace_server_ports_docker.sh'
  sh './replace_server_ports_docker.sh docker-compose.highway.yml'
}

/**
 * Wait for the local node to report isSynced=true AND for Cirrus to catch up
 * to the node tip, failing fast if the node's host processes die while we wait.
 *
 * Every caller deploys with strato-up, so the node's services run under convoke
 * on the host and strato-ps can see them. A from-genesis sync runs for hours,
 * and if convoke dies mid-sync (vm-runner crash, OOM, unclean shutdown) the
 * metadata endpoint simply goes quiet -- without the strato-ps check the poll
 * burns its full ~4h timeout before reporting a generic "failed to sync".
 *
 * isSynced=true only covers the p2p/VM pipeline (node best block vs world best
 * block in Redis). Cirrus is populated by slipstream from a separate Kafka
 * topic (vmevents) and can still be tens of thousands of blocks behind at the
 * moment isSynced flips true, so a second wait covers that layer.
 *
 * @param nodeDir  Node directory to pass to strato-ps. Default: empty, which
 *                 lets strato-ps fall back to ~/.strato/default-node (written
 *                 by strato-init at node setup).
 */
def waitLocalNodeIsSynced(String nodeDir = '') {
  echo "Waiting for local node to be in-sync and healthy..."
  for (int i = 0; i < 9000; i++) {
    if (sh(returnStatus: true, script: "sudo docker exec strato-nginx-1 curl 172.17.0.1:3000/eth/v1.2/metadata | grep \\\"isSynced\\\":true") == 0) {
      waitLocalCirrusIsSynced(nodeDir)
      return true
    }
    // strato-ps shells out to docker compose and strato-barometer, so it costs
    // far more than the metadata poll: check every ~30s, not every 2s. Skipping
    // i=0 also gives convoke a grace period to write .strato.pid, since some
    // callers land here immediately after strato-up returns.
    if (i > 0 && i % 15 == 0) {
      assertStratoIsRunning(nodeDir)
    }
    sleep 2
  }
  error ("STRATO node failed to sync after within the expected time window of ~5hrs. Check the strato logs in artifacts for more details.")
}

/**
 * Wait until Cirrus (slipstream) has indexed up to the node's best block.
 *
 * Mirrors the layer check strato-snapshot create runs for
 * scripts/create-and-publish-snapshot.sh: the node tip comes from apex /status
 * (lastBlock.number, reachable as apex:3009 from the nginx container), the
 * Cirrus tip from max(storage.block_number) in the cirrus DB (same query as
 * strato-snapshot's psql fallback -- no HTTP endpoint serves the Cirrus tip),
 * and Cirrus counts as caught up when it is within 5 blocks of the node tip.
 * Unreadable tips are treated as "keep waiting": on a healthy node both become
 * readable, and a dead node is caught by the strato-ps check below.
 *
 * @param nodeDir  Node directory to pass to strato-ps (see waitLocalNodeIsSynced).
 */
def waitLocalCirrusIsSynced(String nodeDir = '') {
  echo "Node is in-sync; waiting for Cirrus to catch up to the node tip..."
  // ~5h at 10s per poll, matching the isSynced wait window above.
  for (int i = 0; i < 1800; i++) {
    def caughtUp = sh(returnStatus: true, script: '''#!/bin/bash
      ALLOWED_LAG=5
      node_tip=$(sudo docker exec strato-nginx-1 curl -fsS apex:3009/status 2>/dev/null | jq -r '.lastBlock.number // empty' 2>/dev/null)
      cirrus_tip=$(sudo docker exec strato-postgres-1 psql -U postgres -d cirrus -tAc \\
        "select coalesce(max(block_number::numeric), 0)::bigint from storage where block_number ~ '^[0-9]+$';" 2>/dev/null | tr -d '[:space:]')
      if ! [[ "$node_tip" =~ ^[0-9]+$ && "$cirrus_tip" =~ ^[0-9]+$ ]]; then
        echo "Cirrus sync check: tips not readable yet (node_tip='$node_tip', cirrus_tip='$cirrus_tip')"
        exit 1
      fi
      if (( cirrus_tip + ALLOWED_LAG < node_tip )); then
        echo "Cirrus tip ($cirrus_tip) is behind node tip ($node_tip) by more than $ALLOWED_LAG block(s); waiting"
        exit 1
      fi
      echo "Cirrus tip ($cirrus_tip) has caught up to node tip ($node_tip)"
    ''') == 0
    if (caughtUp) {
      return true
    }
    // Same ~30s strato-ps cadence as the isSynced poll (see comment there).
    if (i > 0 && i % 3 == 0) {
      assertStratoIsRunning(nodeDir)
    }
    sleep 10
  }
  error ("Cirrus failed to catch up to the node tip within ~5hrs after the node synced. Slipstream is stuck or too slow; check the slipstream logs in artifacts for more details.")
}

/**
 * Fail the build if strato-ps no longer reports the node's host processes as up.
 * Healthy output contains the two-line block:
 *
 *   Convoke:
 *     Running (PID 12345)
 *
 * The trailing detail after "Running" is required, since that is what tells a
 * live convoke apart from "  Not running".
 *
 * Matching happens in shell rather than via a Groovy regex on purpose: a
 * java.util.regex.Matcher left on the CPS stack across a pipeline step is not
 * serializable and fails the build.
 *
 * @param nodeDir  Node directory to pass to strato-ps (see above).
 */
def assertStratoIsRunning(String nodeDir = '') {
  // Two attempts: strato-ps talks to the docker daemon, which can briefly time
  // out under the IO load of a sync, and a single blip is not a dead node.
  for (int attempt = 0; attempt < 2; attempt++) {
    if (attempt > 0) {
      sleep 5
    }
    def healthy = sh(returnStatus: true, script: """#!/bin/bash -le
      strato-ps ${nodeDir} 2>&1 | grep -A1 -x 'Convoke:' | tail -n +2 | grep -Eq '^  Running.+'
    """) == 0
    if (healthy) {
      return
    }
  }
  sh(returnStatus: true, script: """#!/bin/bash -le
    echo '=== strato-ps ${nodeDir} (unhealthy) ==='
    strato-ps ${nodeDir} 2>&1 || true
    docker ps -a || true
  """)
  error("strato-ps no longer reports STRATO as running; the node's host processes died before the sync completed.")
}

/**
 * Wait for a host-process (strato-up/convoke) node to report isSynced=true via
 * its local metadata endpoint. Unlike waitLocalNodeIsSynced(), this does not
 * rely on the strato-getting-started 'strato-nginx-1' container, so it works
 * with the build-and-strato-up deployment model.
 * @param metadataUrl  Metadata endpoint. Default: http://127.0.0.1:3000/eth/v1.2/metadata
 * @param maxAttempts  Poll attempts before failing. Default: 7000 (~hours at 2s).
 */
def waitHostNodeIsSynced(String metadataUrl = "http://127.0.0.1:3000/eth/v1.2/metadata", int maxAttempts = 7000) {
  echo "Waiting for host node to be in-sync via ${metadataUrl} ..."
  for (int i = 0; i < maxAttempts; i++) {
    if (sh(returnStatus: true, script: "curl -fsS ${metadataUrl} | grep '\"isSynced\":true'") == 0) {
      return true
    }
    sleep 2
  }
  error("STRATO host node failed to sync. Check mynode/logs in artifacts for details.")
}

/**
 * Read the current best block number from a host-process node's metadata
 * endpoint (nodeBestBlock). Returns 0 if unavailable.
 */
def hostNodeBestBlock(String metadataUrl = "http://127.0.0.1:3000/eth/v1.2/metadata") {
  def out = sh(
    returnStdout: true,
    script: "curl -fsS ${metadataUrl} | jq -r '.nodeBestBlock // 0'"
  ).trim()
  return out.isInteger() ? out.toInteger() : 0
}

return this
