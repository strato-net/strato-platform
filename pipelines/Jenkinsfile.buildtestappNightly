pipeline {
  agent {
    label "testnet-buildtest-app"
  }
  environment {
    PATH = "${env.HOME}/.local/bin:${env.PATH}"
  }
  stages {
    
    stage('Prepare') {
      steps {
        sh '''#!/bin/bash -le
          docker system prune -fa || true
        '''
      }
    }
    
    stage('Build') {
      steps {
        sh 'rm -rf .docker-work'
        sh "git checkout BUILD_METADATA"
        script {
          sh '''#!/bin/bash -le
            set -o pipefail
            make | tee make.log
          '''
        }
      }
    }

    stage('Wipe and Deploy') {
      steps {
        sh "unlink strato-platform-origin || true"
        sh "ln -s /home/ubuntu/strato-platform strato-platform-origin"
        dir ("strato-platform-origin") {
          sh "strato-down || (cd mynode docker compose -p strato down -vt0 && cd ..) && sleep 7"
          sh "rm -rf mynode"
          withEnv(['JENKINS_NODE_COOKIE=dontKillMe']) {
            sh "./run.sh"
          }
        }
        script {
          def lib = load("${env.WORKSPACE}/pipelines/Jenkinsfile.library")
          // Then wait for the full sync
          lib.waitLocalNodeIsSynced()
        }
      }
    }
  }

  post {
    success {
      slackSend(
          channel: '#engineering',
          color: 'good',
          message: "buildtest-app.testnet.strato.nexus was wiped and updated with version from develop"
      )
    }
    failure {
      slackSend(
          channel: '#engineering',
          color: 'danger',
          message: "buildtest-app.testnet.strato.nexus has FAILED to wipe and update from develop"
      )
    }
  }
}
