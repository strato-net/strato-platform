    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "viem": "^2.31.2"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.1.3",
    "autoprefixer": "^10.4.20",
