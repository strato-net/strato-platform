#!/usr/bin/env bash

NODE_DIR="${1:-$(cat ~/.strato/default-node 2>/dev/null)}"
if [[ -z "$NODE_DIR" ]]; then
    echo "Usage: strato-ps [node-directory]"
    exit 1
fi

if [[ ! -d "$NODE_DIR" ]]; then
    echo "Node directory does not exist: $NODE_DIR"
    exit 1
fi

cd "$NODE_DIR"

if [[ ! -f .ethereumH/ethconf.yaml ]]; then
    echo "Node not configured: $NODE_DIR"
    echo "Run strato-setup first."
    exit 1
fi

NETWORK=$(grep "^  network:" .ethereumH/ethconf.yaml | awk '{print $2}')

# Check if anything is running
CONVOKE_RUNNING=false
if [[ -f .strato.pid ]]; then
    source .strato.pid
    if [[ -n "$CONVOKE_PID" ]] && kill -0 "$CONVOKE_PID" 2>/dev/null; then
        CONVOKE_RUNNING=true
    fi
fi

DOCKER_COUNT=$(docker compose -p strato ps -q 2>/dev/null | wc -l)

if [[ "$CONVOKE_RUNNING" == "false" && "$DOCKER_COUNT" -eq 0 ]]; then
    echo "STRATO is not running ($NETWORK node at $NODE_DIR)"
    exit 0
fi

# Something is running - show details
echo "######## STRATO Status: $(pwd)"
echo "Network: $NETWORK"

# Sync status
if [[ "$CONVOKE_RUNNING" == "true" ]]; then
    BAROMETER=$(strato-barometer syncstats 2>/dev/null)
    # Positions come from the "Block Positions:" table (label: number description).
    pos() { echo "$BAROMETER" | awk -v l="$1:" '$1 == l {print $2}'; }
    SEQ_BLOCK=$(pos sequencer)
    VM_BLOCK=$(pos vm)
    IDX_BLOCK=$(pos indexed)
    CIRRUS_BLOCK=$(pos cirrus)
    WORLD_BLOCK=$(pos world)
    SYNCED=$(echo "$BAROMETER" | grep -A2 "^Sync Status:$" | tail -1)
    if [[ -n "$WORLD_BLOCK" && "$WORLD_BLOCK" != "-" && "$SYNCED" != "True" && "$IDX_BLOCK" != "-" ]]; then
        PERCENT=$(awk "BEGIN {printf \"%.1f\", ($IDX_BLOCK / $WORLD_BLOCK) * 100}")
        echo "Sync: syncing, $PERCENT% (indexed $IDX_BLOCK / world $WORLD_BLOCK)"
    elif [[ "$SYNCED" == "True" ]]; then
        echo "Sync: synced"
    fi
    echo "Block positions:"
    printf "  %-10s %-10s %s\n" \
        "sequencer:" "$SEQ_BLOCK"    "(strato-sequencer, last committed)" \
        "vm:"        "$VM_BLOCK"     "(vm-runner, last executed)" \
        "indexed:"   "$IDX_BLOCK"    "(strato-indexer, committed to SQL/Redis)" \
        "cirrus:"    "$CIRRUS_BLOCK" "(slipstream, indexed into Cirrus)" \
        "world:"     "$WORLD_BLOCK"  "(highest peer-reported)"
fi

echo ""
echo "Docker containers:"
docker compose -p strato ps --format "table {{.Name}}\t{{.Status}}" 2>/dev/null || echo "  None"

echo ""
echo "Convoke:"
if [[ "$CONVOKE_RUNNING" == "true" ]]; then
    echo "  Running (PID $CONVOKE_PID)"
    echo "  Processes:"
    for pid in $(pgrep -P "$CONVOKE_PID" 2>/dev/null); do
        # Show the script name for interpreter-run services (e.g.
        # "bash .../strato-logrotate" -> "strato-logrotate"), stripping any path.
        cmd=$(ps -p "$pid" -o args= 2>/dev/null | awk '{ c=$1; if (c ~ /(^|\/)(bash|sh|dash)$/ && NF > 1) c=$2; sub(/.*\//, "", c); print c }')
        echo "    $cmd ($pid)"
    done
else
    echo "  Not running"
fi
