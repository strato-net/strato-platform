#!/usr/bin/env bash

set -e

# Parse snapshot restore options (strato-up only; not passed to strato-setup):
#   --snapshot[=<timestamp>]   Restore from the published S3 snapshot for the
#                              selected --network (latest, or a timestamp).
#   --snapshot-source=<src>    Restore from an explicit local file or s3:// URI
#                              (e.g. to validate a freshly created archive before
#                              it is published). Takes precedence over --snapshot.
# Restore happens after strato-setup and before convoke is started.
FROM_SNAPSHOT="false"
SNAPSHOT_TIMESTAMP=""
SNAPSHOT_SOURCE=""
NETWORK="upquark"
SETUP_ARGS=()
for arg in "$@"; do
    case "$arg" in
        # --patch-app was removed - inform the user. To be removed soon.
        --patch-app)
            echo "Error: the --patch-app flag has been removed from strato-up."
            echo "Use 'strato-patch-app' instead (see README for details)."
            exit 1
            ;;
        --snapshot)
            FROM_SNAPSHOT="true"
            ;;
        --snapshot=*)
            FROM_SNAPSHOT="true"
            SNAPSHOT_TIMESTAMP="${arg#*=}"
            ;;
        --snapshot-source=*)
            FROM_SNAPSHOT="true"
            SNAPSHOT_SOURCE="${arg#*=}"
            ;;
        --network=*)
            NETWORK="${arg#*=}"
            SETUP_ARGS+=("$arg")
            ;;
        *)
            SETUP_ARGS+=("$arg")
            ;;
    esac
done

NODE_DIR="$1"

# If the node directory already exists, we are just (re)starting an existing node,
# not instantiating a new one - so a snapshot restore is neither needed nor safe.
# This must be checked before strato-setup, which creates the directory.
if [[ "$FROM_SNAPSHOT" == "true" && -n "$NODE_DIR" && -d "$NODE_DIR" ]]; then
    echo "Note: the --snapshot flag is ignored because node directory '$NODE_DIR' already exists;"
    echo "      starting the existing node without downloading or restoring a snapshot."
    FROM_SNAPSHOT="false"
fi

strato-setup "${SETUP_ARGS[@]}"

if [[ "$FROM_SNAPSHOT" == "true" ]]; then
    if [[ -n "$SNAPSHOT_SOURCE" ]]; then
        SNAPSHOT_ARG=(--source "$SNAPSHOT_SOURCE")
        echo "Restoring node from $NETWORK snapshot source ($SNAPSHOT_SOURCE)..."
    elif [[ -n "$SNAPSHOT_TIMESTAMP" ]]; then
        SNAPSHOT_ARG=("--snapshot=$SNAPSHOT_TIMESTAMP")
        echo "Restoring node from $NETWORK snapshot ($SNAPSHOT_TIMESTAMP)..."
    else
        SNAPSHOT_ARG=(--snapshot)
        echo "Restoring node from latest $NETWORK snapshot..."
    fi
    if ! strato-snapshot restore "$NODE_DIR" "${SNAPSHOT_ARG[@]}" --network "$NETWORK" --force; then
        echo "Error: snapshot restore failed; not starting STRATO." >&2
        exit 1
    fi
fi

cd "$NODE_DIR"
NODE_DIR_ABS="$(pwd)"

# Check if node is already running
if [[ -f .strato.pid ]]; then
    source .strato.pid
    if [[ -n "$CONVOKE_PID" ]] && kill -0 "$CONVOKE_PID" 2>/dev/null; then
        echo "Error: STRATO is already running in $(pwd) (convoke PID $CONVOKE_PID)"
        echo "Run 'strato-down' first to stop the running node."
        exit 1
    fi
    # Stale pidfile from a previous crashed run — clean it up
    rm -f .strato.pid
fi

echo "Starting convoke..."
# Keep convoke detached from this shell's output streams so it survives callers
# that close their pipes as soon as strato-up returns (SSH, CI, and API-driven
# shells). Operators can follow logs/convoke.log separately.
: > logs/convoke.log
nohup convoke >> logs/convoke.log 2>&1 </dev/null &
CONVOKE_PID=$!
echo "CONVOKE_PID=$CONVOKE_PID" > .strato.pid

if grep -q "local-auth:" docker-compose.yml; then
    echo "Ensuring local auth admin and node identity setup..."
    USER_ADD_ARGS=("$NODE_DIR_ABS" "${LOCAL_AUTH_ADMIN_USERNAME:-admin}" --with-nodekey)
    if [[ -n "${LOCAL_AUTH_PASSWORD_FILE:-}" ]]; then
        USER_ADD_ARGS+=("--password-file=${LOCAL_AUTH_PASSWORD_FILE}")
    fi
    if [[ -n "${LOCAL_AUTH_PRIVATE_KEY_FILE:-}" ]]; then
        USER_ADD_ARGS+=("--private-key-file=${LOCAL_AUTH_PRIVATE_KEY_FILE}")
    fi
    if ! strato-user-add "${USER_ADD_ARGS[@]}"; then
        echo "Error: local auth admin setup failed; stopping STRATO." >&2
        kill "$CONVOKE_PID" 2>/dev/null || true
        rm -f .strato.pid
        exit 1
    fi
fi

echo "STRATO started in: $(pwd)"
