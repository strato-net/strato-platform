#!/usr/bin/env bash

set -e

# Parse --snapshot[=<timestamp>] (strato-up only; not passed to strato-setup).
# When present, the node is restored from a published S3 snapshot for the
# selected --network after setup and before convoke is started.
FROM_SNAPSHOT="false"
SNAPSHOT_TIMESTAMP=""
NETWORK="upquark"
SETUP_ARGS=()
for arg in "$@"; do
    case "$arg" in
        # --patch-app was removed - inform the user. To be removed soon.
        --patch-app)
            echo "Error: the --patch-app flag has been removed from strato-up."
            echo "Use 'strato-patch-app' instead (see README for details)."
            exit 1
            ;;
        --snapshot)
            FROM_SNAPSHOT="true"
            ;;
        --snapshot=*)
            FROM_SNAPSHOT="true"
            SNAPSHOT_TIMESTAMP="${arg#*=}"
            ;;
        --network=*)
            NETWORK="${arg#*=}"
            SETUP_ARGS+=("$arg")
            ;;
        *)
            SETUP_ARGS+=("$arg")
            ;;
    esac
done

strato-setup "${SETUP_ARGS[@]}"
NODE_DIR="$1"

if [[ "$FROM_SNAPSHOT" == "true" ]]; then
    SNAPSHOT_ARG="--snapshot"
    if [[ -n "$SNAPSHOT_TIMESTAMP" ]]; then
        SNAPSHOT_ARG="--snapshot=$SNAPSHOT_TIMESTAMP"
        echo "Restoring node from $NETWORK snapshot ($SNAPSHOT_TIMESTAMP)..."
    else
        echo "Restoring node from latest $NETWORK snapshot..."
    fi
    if ! strato-snapshot restore "$NODE_DIR" "$SNAPSHOT_ARG" --network "$NETWORK" --force; then
        echo "Error: snapshot restore failed; not starting STRATO." >&2
        exit 1
    fi
fi

cd "$NODE_DIR"
NODE_DIR_ABS="$(pwd)"

# Check if node is already running
if [[ -f .strato.pid ]]; then
    source .strato.pid
    if [[ -n "$CONVOKE_PID" ]] && kill -0 "$CONVOKE_PID" 2>/dev/null; then
        echo "Error: STRATO is already running in $(pwd) (convoke PID $CONVOKE_PID)"
        echo "Run 'strato-down' first to stop the running node."
        exit 1
    fi
    # Stale pidfile from a previous crashed run — clean it up
    rm -f .strato.pid
fi

echo "Starting convoke..."
# stdout goes to log, stderr goes to both log and terminal
nohup convoke > logs/convoke.log 2> >(tee -a logs/convoke.log >&2) &
CONVOKE_PID=$!
echo "CONVOKE_PID=$CONVOKE_PID" > .strato.pid

if grep -q "local-auth:" docker-compose.yml; then
    echo "Ensuring local auth admin and node identity setup..."
    if ! strato-user-add "$NODE_DIR_ABS" "${LOCAL_AUTH_ADMIN_USERNAME:-admin}" --with-nodekey; then
        echo "Error: local auth admin setup failed; stopping STRATO." >&2
        kill "$CONVOKE_PID" 2>/dev/null || true
        rm -f .strato.pid
        exit 1
    fi
fi

echo "STRATO started in: $(pwd)"
