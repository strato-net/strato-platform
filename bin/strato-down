#!/usr/bin/env bash

set -e

NODE_DIR="${1:-$(cat ~/.strato/default-node 2>/dev/null)}"
if [[ -z "$NODE_DIR" ]]; then
    echo "Usage: strato-down [node-directory]"
    exit 1
fi

cd "$NODE_DIR"

echo "Stopping STRATO..."

# A --dockerMode=all node (strato-setup) has no host
# convoke: the strato container runs it, and compose stops the whole project.
if grep -qx '  strato:' docker-compose.yml 2>/dev/null; then
    docker compose -p strato down
    echo "STRATO stopped"
    exit 0
fi

if [[ -f .strato.pid ]]; then
    source .strato.pid
    if [[ -n "$CONVOKE_PID" ]] && kill -0 "$CONVOKE_PID" 2>/dev/null; then
        kill "$CONVOKE_PID" 2>/dev/null || true
        # No time limit: removing the pidfile or the containers while convoke
        # is still stopping its processes would orphan them mid-write.
        while kill -0 "$CONVOKE_PID" 2>/dev/null; do
            sleep 1
        done
    fi
    rm -f .strato.pid
else
    echo "No pidfile found"
fi

# Convoke normally stops the containers itself. Also do it here so a failed
# startup or a platform without GNU tail cannot leave the project running.
docker compose -p strato down

echo "STRATO stopped"
