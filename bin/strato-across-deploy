#!/usr/bin/env python3
"""Prepare, broadcast, and audit the isolated SolidVM Across deployment.

Preparation is offline and read-only. Broadcasting requires both --broadcast
and a chain-specific acknowledgment so invoking the tool accidentally cannot
change a network.
"""

import argparse
import hashlib
import ipaddress
import json
import os
import re
import stat
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path


