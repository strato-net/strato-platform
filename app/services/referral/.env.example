NODE_URL=xxxxxxxxxxxxx                                # STRATO node URL (https://app.testnet.strato.nexus for Helium)
ESCROW_ADDRESS=xxxxxxxxxxxxx                          # The Escrow contract the claims redeem from
SIGNER_PRIVATE_KEY=                                   # Optional. The key that submits claims and pays gas; left empty, the service makes one in data/signer.key
CHAIN_ID=                                             # Optional. The STRATO chain the Escrow is on, when not the node's main chain
PORT=3003
GAS_FEE_USDST=1                                       # Gas per transaction in USDST (times 1e16), for the balance warning
MIN_TRANSACTIONS_THRESHOLD=200                        # Warn on /health when fewer transactions than this can be paid for
