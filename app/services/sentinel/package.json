{
  "name": "strato-sentinel-service",
  "version": "1.0.0",
  "description": "Read-only security monitor for STRATO - watches Cirrus events for governance, ownership and key-misuse signals and alerts Slack",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node src/index.ts",
    "once": "ts-node src/index.ts --once",
    "dev": "nodemon src/index.ts",
    "build": "tsc"
  },
  "engines": {
    "node": ">=22.12 <23.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^16.3.1",
    "ethers": "^6.17.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
