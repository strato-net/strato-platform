# STRATO node base url; reads <NODE_URL>/cirrus/search and <NODE_URL>/strato-api anonymously
NODE_URL=https://app.testnet.strato.nexus

# Accounts expected to execute functions through AdminRegistry (oracle feeders,
# bridge relayer, minting contracts, ...). Any IssueExecuted outside this list raises a high alert.
# Quote the value — ';' ends the line when the file is sourced by a shell.
#   KNOWN_EXECUTORS="<executor>=<func>,<func>; <executor2>=<func>"
KNOWN_EXECUTORS=""

# A governed mint at or above this % of the token's total supply raises a high alert
MINT_ALERT_PCT=5
# Failed transactions from one sender within one scan that raise a high alert
FAIL_BURST=20
# How often every proxy's logic contract is diffed against the last snapshot
PROXY_SNAPSHOT_SECONDS=300
# A governed token's supply growing by at least this % between snapshots raises a high alert
SUPPLY_JUMP_PCT=10
SUPPLY_SNAPSHOT_SECONDS=3600
# A bridge-out worth more than this many USD (price oracle 0x1002) raises a critical alert
BRIDGE_OUT_ALERT_USD=5000

# --- external chains (optional) ---
# Native bridge contracts on Ethereum/Base. Each chain needs CHAIN_<chainId>_RPC_URL
# (same variable names as the bridge service). Every RepresentationMinted is checked
# against the STRATO withdrawal it names on STRATO_NATIVE_BRIDGE.
#   EVM_BRIDGES="<chainId>=<bridge>,<bridge>; <chainId2>=<bridge>"
EVM_BRIDGES=""
STRATO_NATIVE_BRIDGE=
# CHAIN_1_RPC_URL=
# CHAIN_8453_RPC_URL=
EVM_CONFIRMATIONS=2
# Blocks per eth_getLogs request
EVM_LOG_CHUNK=2000

POLL_INTERVAL_SECONDS=30
# Rows fetched per Cirrus / strato-api request
PAGE_SIZE=1000

# --- Slack (bot token + channel ids, chat.postMessage) ---
# Critical/high alerts go to SLACK_CHANNEL_ID; info alerts go to SLACK_INFO_CHANNEL_ID
# (logged only when unset). Without SLACK_TOKEN/SLACK_CHANNEL_ID everything is log-only.
SLACK_TOKEN=
SLACK_CHANNEL_ID=
SLACK_INFO_CHANNEL_ID=

# --- service ---
HEALTH_PORT=3008
# STATE_FILE=/var/lib/sentinel/state.json
