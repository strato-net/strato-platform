# Local development configuration (docker-run.sh sets these in containers)
PORT=3010
NODE_URL=http://localhost
OPENID_DISCOVERY_URL=https://keycloak.blockapps.net/auth/realms/mercata/.well-known/openid-configuration

postgres_host=localhost
postgres_port=5432
postgres_user=postgres
postgres_password=postgres
TRACKING_DB_NAME=tracking

TRACKING_AUTHORIZED_USERS=jeff@example.com,kieren@example.com
TRACKING_DEFAULT_DESTINATION=/dashboard/deposits
TRACKING_COOKIE_DOMAIN=
TRACKING_ATTRIBUTION_WINDOW_DAYS=90
TRACKING_ATTRIBUTION_GRACE_MINUTES=30
TRACKING_IP_FALLBACK_MINUTES=30
TRACKING_CACHE_TTL_SECONDS=60
# Optional origin-chain enrichment of the user timeline (Etherscan V2 API key)
TRACKING_ETHERSCAN_API_KEY=
TRACKING_ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
TRACKING_ETHERSCAN_MAX_TX=10
ssl=false
