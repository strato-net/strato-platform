{
  "name": "strato-tracking-service",
  "version": "1.0.0",
  "description": "Tracking-links service: short link resolver, session/wallet event capture, and Cirrus-joined attribution dashboard API",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --test -r ts-node/register test/*.test.ts"
  },
  "engines": {
    "node": ">=22.12 <23.0"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "geoip-lite": "^1.4.10",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^4.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.11.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
