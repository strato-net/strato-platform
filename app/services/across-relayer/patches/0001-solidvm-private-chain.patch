diff --git a/scripts/solidvm-smoke.ts b/scripts/solidvm-smoke.ts
new file mode 100644
index 0000000..73ace8e
--- /dev/null
+++ b/scripts/solidvm-smoke.ts
@@ -0,0 +1,154 @@
+import fs from "fs";
+import { TransactionClient } from "../src/clients/TransactionClient";
+import { submitTransaction } from "../src/utils/TransactionUtils";
+import { ERC20, SpokePool, ethers, winston } from "../src/utils";
+
+function required(name: string): string {
+  const value = process.env[name];
+  if (!value) throw new Error(`${name} is required`);
+  return value;
+}
+
+async function waitForFilledRelay(
+  provider: ethers.providers.Provider,
+  spokePool: ethers.Contract,
+  transactionHash: string,
+  initialReceipt: ethers.providers.TransactionReceipt
+): Promise<{ receipt: ethers.providers.TransactionReceipt; events: string[] }> {
+  let receipt = initialReceipt;
+  for (let attempt = 0; attempt < 100; attempt += 1) {
+    const events = receipt.logs.flatMap((log) => {
+      try {
+        return [spokePool.interface.parseLog(log).name];
+      } catch {
+        return [];
+      }
+    });
+    if (events.includes("FilledRelay")) return { receipt, events };
+
+    // SolidVM commits the transaction before Slipstream has necessarily
+    // projected its emitted events into Cirrus. Polling the same receipt is
+    // bounded and preserves the normal Ethereum receipt/log interface.
+    await new Promise((resolve) => setTimeout(resolve, 100));
+    receipt = (await provider.getTransactionReceipt(transactionHash)) ?? receipt;
+  }
+  throw new Error("FilledRelay log was not indexed within 10 seconds");
+}
+
+async function main(): Promise<void> {
+  const rpcUrl = required("SOLIDVM_RPC_URL");
+  const spokePoolAddress = required("SOLIDVM_SPOKE_POOL_ADDRESS");
+  const tokenAddress = required("SOLIDVM_OUTPUT_TOKEN_ADDRESS");
+  const mnemonic = fs.readFileSync(required("SOLIDVM_TEST_MNEMONIC_FILE"), "utf8").trim();
+
+  const provider = new ethers.providers.JsonRpcProvider(rpcUrl);
+  const { chainId } = await provider.getNetwork();
+  const relayer = ethers.Wallet.fromMnemonic(mnemonic, "m/44'/60'/0'/0/1").connect(provider);
+  const recipient = ethers.Wallet.fromMnemonic(mnemonic, "m/44'/60'/0'/0/2").address;
+  const relayerAddress = await relayer.getAddress();
+  const logger = winston.createLogger({
+    level: "debug",
+    format: winston.format.json(),
+    transports: [new winston.transports.Console()],
+  });
+  const transactionClient = new TransactionClient(logger);
+  const token = ERC20.connect(tokenAddress, relayer);
+  const spokePool = SpokePool.connect(spokePoolAddress, relayer);
+  const amount = ethers.utils.parseEther("1");
+  const depositId = Number(process.env.SOLIDVM_DEPOSIT_ID ?? "424243");
+  if (!Number.isSafeInteger(depositId) || depositId < 0) throw new Error("SOLIDVM_DEPOSIT_ID must be a non-negative safe integer");
+  const recipientBefore = await token.balanceOf(recipient);
+  const relayerBefore = await token.balanceOf(relayerAddress);
+
+  let approvalResponse: ethers.providers.TransactionResponse | undefined;
+  let approvalReceipt: ethers.providers.TransactionReceipt | undefined;
+  if ((await token.allowance(relayerAddress, spokePoolAddress)).lt(amount)) {
+    approvalResponse = await submitTransaction(
+      {
+        contract: token,
+        chainId,
+        method: "approve",
+        args: [spokePoolAddress, amount],
+        ensureConfirmation: true,
+        message: "Approve SolidVM SpokePool",
+      },
+      transactionClient
+    );
+    approvalReceipt = await approvalResponse.wait();
+  }
+
+  const asBytes32 = (address: string): string => ethers.utils.hexZeroPad(address, 32);
+  const relayData = {
+    depositor: asBytes32(ethers.Wallet.fromMnemonic(mnemonic, "m/44'/60'/0'/0/3").address),
+    recipient: asBytes32(recipient),
+    exclusiveRelayer: ethers.constants.HashZero,
+    inputToken: asBytes32(tokenAddress),
+    outputToken: asBytes32(tokenAddress),
+    inputAmount: amount,
+    outputAmount: amount,
+    originChainId: 1,
+    depositId,
+    fillDeadline: Math.floor(Date.now() / 1000) + 3600,
+    exclusivityDeadline: 0,
+    message: "0x",
+  };
+
+  const fillResponse = await submitTransaction(
+    {
+      contract: spokePool,
+      chainId,
+      method: "fillRelay",
+      args: [relayData, chainId, asBytes32(relayerAddress)],
+      ensureConfirmation: true,
+      message: "Fill synthetic Across relay on SolidVM",
+    },
+    transactionClient
+  );
+  const initialFillReceipt = await fillResponse.wait();
+  const { receipt: fillReceipt, events: parsedLogs } = await waitForFilledRelay(
+    provider,
+    spokePool,
+    fillResponse.hash,
+    initialFillReceipt
+  );
+  const recipientAfter = await token.balanceOf(recipient);
+  const relayerAfter = await token.balanceOf(relayerAddress);
+  if (!recipientAfter.sub(recipientBefore).eq(amount)) throw new Error("recipient did not receive the fill amount");
+
+  process.stdout.write(
+    `${JSON.stringify(
+      {
+        chainId,
+        relayer: relayerAddress,
+        recipient,
+        spokePool: spokePoolAddress,
+        approval: {
+          hash: approvalResponse?.hash ?? null,
+          status: approvalReceipt?.status ?? null,
+          gasUsed: approvalReceipt?.gasUsed.toString() ?? null,
+          reusedExistingAllowance: approvalResponse === undefined,
+        },
+        fill: {
+          depositId,
+          hash: fillResponse.hash,
+          status: fillReceipt.status,
+          gasUsed: fillReceipt.gasUsed.toString(),
+          events: parsedLogs,
+        },
+        balances: {
+          relayerBefore: relayerBefore.toString(),
+          relayerAfter: relayerAfter.toString(),
+          recipientBefore: recipientBefore.toString(),
+          recipientAfter: recipientAfter.toString(),
+        },
+      },
+      null,
+      2
+    )}\n`
+  );
+}
+
+main().catch((error: unknown) => {
+  process.stderr.write(`${error instanceof Error ? error.stack ?? error.message : String(error)}\n`);
+  process.exitCode = 1;
+});
