@@ -0,0 +1,55 @@
+import fs from "fs";
+import os from "os";
+import path from "path";
+import { expect } from "chai";
+import { getHeliosProofApiHeaders } from "../src/utils/ProofApiAuth";
+
+describe("ProofApiAuth", function () {
+  let tempDir: string;
+  let previousPath: string | undefined;
+
+  beforeEach(function () {
+    tempDir = fs.mkdtempSync(path.join(os.tmpdir(), "across-proof-auth-"));
+    previousPath = process.env.HELIOS_PROOF_API_HEADERS_FILE;
+  });
+
+  afterEach(function () {
+    fs.rmSync(tempDir, { recursive: true, force: true });
+    if (previousPath === undefined) delete process.env.HELIOS_PROOF_API_HEADERS_FILE;
+    else process.env.HELIOS_PROOF_API_HEADERS_FILE = previousPath;
+  });
+
+  it("returns no headers when the optional secret file is not configured", function () {
+    delete process.env.HELIOS_PROOF_API_HEADERS_FILE;
+    expect(getHeliosProofApiHeaders()).to.deep.equal({});
+  });
+
+  it("loads a private JSON header file and observes rotation", function () {
+    const secret = path.join(tempDir, "headers.json");
+    fs.writeFileSync(secret, JSON.stringify({ Authorization: "Bearer first" }), { mode: 0o600 });
+    process.env.HELIOS_PROOF_API_HEADERS_FILE = secret;
+    expect(getHeliosProofApiHeaders()).to.deep.equal({ Authorization: "Bearer first" });
+    fs.writeFileSync(secret, JSON.stringify({ Authorization: "Bearer second" }), { mode: 0o600 });
+    expect(getHeliosProofApiHeaders()).to.deep.equal({ Authorization: "Bearer second" });
+  });
+
+  it("rejects a group-readable or symlinked secret file", function () {
+    const secret = path.join(tempDir, "headers.json");
+    fs.writeFileSync(secret, JSON.stringify({ Authorization: "Bearer secret" }), { mode: 0o640 });
+    process.env.HELIOS_PROOF_API_HEADERS_FILE = secret;
+    expect(() => getHeliosProofApiHeaders()).to.throw("must not be accessible by group/other");
+
+    fs.chmodSync(secret, 0o600);
+    const link = path.join(tempDir, "headers-link.json");
+    fs.symlinkSync(secret, link);
+    process.env.HELIOS_PROOF_API_HEADERS_FILE = link;
+    expect(() => getHeliosProofApiHeaders()).to.throw("must be a regular file");
+  });
+
+  it("rejects header-value injection", function () {
+    const secret = path.join(tempDir, "headers.json");
+    fs.writeFileSync(secret, JSON.stringify({ Authorization: "Bearer ok\r\nX-Injected: yes" }), { mode: 0o600 });
+    process.env.HELIOS_PROOF_API_HEADERS_FILE = secret;
+    expect(() => getHeliosProofApiHeaders()).to.throw("without CR/LF");
+  });
+});
