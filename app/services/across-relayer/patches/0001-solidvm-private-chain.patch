diff --git a/src/utils/CustomChainUtils.ts b/src/utils/CustomChainUtils.ts
new file mode 100644
index 0000000..528cafb
--- /dev/null
+++ b/src/utils/CustomChainUtils.ts
@@ -0,0 +1,55 @@
+import assert from "assert";
+
+export interface CustomChainConfig {
+  name: string;
+  nativeTokenSymbol: string;
+  family: "evm";
+  spokePoolAddress: string;
+  spokePoolDeploymentBlock: number;
+  universalSpoke: boolean;
+}
+
+function parseCustomChains(): Record<string, Partial<CustomChainConfig>> {
+  const rawConfig = process.env.ACROSS_CUSTOM_CHAINS;
+  return rawConfig === undefined ? {} : (JSON.parse(rawConfig) as Record<string, Partial<CustomChainConfig>>);
+}
+
+export function getCustomChainIds(): number[] {
+  return Object.keys(parseCustomChains()).map((rawChainId) => {
+    const chainId = Number(rawChainId);
+    assert(Number.isSafeInteger(chainId) && chainId > 0, `Invalid custom chain id ${rawChainId}`);
+    return chainId;
+  });
+}
+
+export function getCustomChainConfig(chainId: number): CustomChainConfig | undefined {
+  assert(Number.isSafeInteger(chainId) && chainId > 0, `Invalid custom chain id ${chainId}`);
+  const parsed = parseCustomChains();
+  const config = parsed[chainId.toString()];
+  if (config === undefined) {
+    return undefined;
+  }
+
+  assert(config.family === "evm", `Custom chain ${chainId} must declare family \"evm\"`);
+  assert(typeof config.name === "string" && config.name.length > 0, `Custom chain ${chainId} is missing name`);
+  assert(
+    typeof config.nativeTokenSymbol === "string" && config.nativeTokenSymbol.length > 0,
+    `Custom chain ${chainId} is missing nativeTokenSymbol`
+  );
+  assert(
+    typeof config.spokePoolAddress === "string" && /^0x[0-9a-fA-F]{40}$/.test(config.spokePoolAddress),
+    `Custom chain ${chainId} has an invalid spokePoolAddress`
+  );
+  const deploymentBlock = config.spokePoolDeploymentBlock;
+  assert(
+    Number.isSafeInteger(deploymentBlock) && (deploymentBlock ?? -1) >= 0,
+    `Custom chain ${chainId} has an invalid spokePoolDeploymentBlock`
+  );
+  assert(typeof config.universalSpoke === "boolean", `Custom chain ${chainId} is missing universalSpoke`);
+
+  return config as CustomChainConfig;
+}
+
+export function customChainUsesUniversalSpoke(chainId: number): boolean {
+  return getCustomChainConfig(chainId)?.universalSpoke === true;
+}
