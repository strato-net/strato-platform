diff --git a/src/utils/ProofApiAuth.ts b/src/utils/ProofApiAuth.ts
new file mode 100644
index 0000000..782ba79
--- /dev/null
+++ b/src/utils/ProofApiAuth.ts
@@ -0,0 +1,32 @@
+import assert from "assert";
+import fs from "fs";
+
+/**
+ * Load prover authentication headers from a private file on every finalizer
+ * pass. This keeps credentials out of process arguments/environment dumps and
+ * permits atomic secret rotation without restarting the relayer.
+ */
+export function getHeliosProofApiHeaders(): Record<string, string> {
+  const file = process.env.HELIOS_PROOF_API_HEADERS_FILE;
+  if (!file) return {};
+
+  const linkStatus = fs.lstatSync(file);
+  assert(linkStatus.isFile() && !linkStatus.isSymbolicLink(), "HELIOS_PROOF_API_HEADERS_FILE must be a regular file");
+  assert((linkStatus.mode & 0o077) === 0, "HELIOS_PROOF_API_HEADERS_FILE must not be accessible by group/other");
+
+  const decoded = JSON.parse(fs.readFileSync(file, "utf8")) as unknown;
+  assert(decoded !== null && typeof decoded === "object" && !Array.isArray(decoded), "Proof API headers must be a JSON object");
+  const headers = decoded as Record<string, unknown>;
+  assert(Object.keys(headers).length > 0, "Proof API headers must not be empty");
+  assert(
+    Object.entries(headers).every(
+      ([name, value]) =>
+        /^[!#$%&'*+.^_`|~0-9A-Za-z-]+$/.test(name) &&
+        typeof value === "string" &&
+        value.length > 0 &&
+        !/[\r\n]/.test(value)
+    ),
+    "Proof API header names and values must be non-empty strings without CR/LF"
+  );
+  return headers as Record<string, string>;
+}
