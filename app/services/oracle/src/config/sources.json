{
  "Alchemy": {
    "url": "https://api.g.alchemy.com/prices/v1/${API_KEY}/tokens/by-symbol",
    "params": "symbols[]",
    "parse": "data[].prices[0].value",
    "timestamp": "data[0].prices[0].lastUpdatedAt",
    "apiKeyEnvVar": "ALCHEMY_API_KEY",
    "assets": ["ETH", "WBTC", "PAXG", "XAUT", "SUSDS", "WSTETH", "SYRUPUSDC", "RETH", "USDC", "USDT", "TSLAX","WEETH"]
  },
  "CoinMarketCap": {
    "url": "https://pro-api.coinmarketcap.com/v2/cryptocurrency/quotes/latest",
    "params": "symbol,convert=USD",
    "headers": "X-CMC_PRO_API_KEY",
    "parse": "data.{symbol}[0].quote.USD.price",
    "timestamp": "data.{firstSymbol}[0].quote.USD.last_updated",
    "apiKeyEnvVar": "COINMARKETCAP_API_KEY",
    "assets": ["ETH", "WBTC", "PAXG", "XAUT", "WSTETH", "SYRUPUSDC", "RETH", "USDC", "USDT", "WEETH"]
  },
  "Metals.dev": {
    "url": "https://api.metals.dev/v1/latest",
    "params": "api_key,currency=USD,unit=toz,metals",
    "parse": "metals.{metal}",
    "timestamp": "timestamps.metal",
    "apiKeyEnvVar": "METALS_DEV_API_KEY",
    "assets": ["XAU", "XAG"],
    "symbolMapping": {
      "XAU": "gold",
      "XAG": "silver"
    }
  },
  "MetalsAPI": {
    "url": "https://metals-api.com/api/latest",
    "params": "access_key,base=USD,symbols",
    "parse": "rates.USD{symbol}",
    "timestamp": "timestamp",
    "apiKeyEnvVar": "METALS_API_API_KEY",
    "assets": ["XAU", "XAG"]
  },
  "CoinGecko": {
    "url": "https://pro-api.coingecko.com/api/v3/simple/price",
    "params": "x_cg_pro_api_key,ids,vs_currencies=usd,include_last_updated_at=true",
    "parse": "{id}.usd",
    "timestamp": "{id}.last_updated_at",
    "apiKeyEnvVar": "COINGECKO_API_KEY",
    "assets": ["ETH", "WBTC", "PAXG", "XAUT", "SUSDS", "WSTETH", "SYRUPUSDC", "RETH", "USDC", "USDT", "TSLAX", "SPY", "SPYX", "TSLA", "WEETH"],
    "symbolMapping": {
      "ETH": "ethereum",
      "WBTC": "wrapped-bitcoin",
      "PAXG": "pax-gold",
      "XAUT": "tether-gold",
      "SUSDS": "susds",
      "WSTETH": "wrapped-steth",
      "SYRUPUSDC": "syrupusdc",
      "RETH": "rocket-pool-eth",
      "USDC": "usd-coin",
      "USDT": "tether",
      "TSLAX": "tesla-xstock",
      "TSLA": "tesla-xstock",
      "SPY": "sp500-xstock",
      "SPYX": "sp500-xstock",
      "WEETH": "wrapped-eeth"
    }
  },
  "CoinAPI": {
    "url": "https://rest.coinapi.io/v1/assets",
    "params": "filter_asset_id",
    "headers": "X-CoinAPI-Key",
    "parse": "assets",
    "timestamp": "data_quote_start",
    "apiKeyEnvVar": "COINAPI_API_KEY",
    "assets": ["ETH", "WBTC", "PAXG", "XAUT", "USDC", "USDT", "TSLAX", "SPY", "SPYX", "TSLA", "WEETH"]
  },
  "DefiLlama": {
    "url": "https://pro-api.llama.fi/${API_KEY}/coins/prices/current/${SYMBOLS}",
    "parse": "defiLlama",
    "apiKeyEnvVar": "DEFILLAMA_API_KEY",
    "assets": ["ETH", "WBTC", "PAXG", "XAUT", "SUSDS", "WSTETH", "SYRUPUSDC", "RETH", "USDC", "USDT", "TSLAX", "SPY", "SPYX", "TSLA", "WEETH"],
    "symbolMapping": {
      "ETH": "coingecko:ethereum",
      "WBTC": "coingecko:wrapped-bitcoin",
      "PAXG": "coingecko:pax-gold",
      "XAUT": "coingecko:tether-gold",
      "SUSDS": "coingecko:susds",
      "WSTETH": "coingecko:wrapped-steth",
      "SYRUPUSDC": "coingecko:syrupusdc",
      "RETH": "coingecko:rocket-pool-eth",
      "USDC": "coingecko:usd-coin",
      "USDT": "coingecko:tether",
      "TSLAX": "coingecko:tesla-xstock",
      "TSLA": "coingecko:tesla-xstock",
      "SPY": "coingecko:sp500-xstock",
      "SPYX": "coingecko:sp500-xstock",
      "WEETH": "coingecko:wrapped-eeth"
    }
  },
  "DexScreener": {
    "url": "https://api.dexscreener.com/latest/dex/tokens/${SYMBOLS}",
    "parse": "dexscreener",
    "comment": "Free, no API key. Response is an array of pairs across DEXes; parser must filter chainId=='ethereum' and baseToken.address==<mapped address>, then pick the highest-liquidity.usd pair's priceUsd. symbolMapping is the ERC-20 contract address.",
    "assets": ["SUSDS"],
    "symbolMapping": {
      "SUSDS": "0xa3931d71877c0e7a3148cb7eb4463524fec27fbd"
    }
  },
  "CommodityPriceAPI": {
    "url": "https://api.commoditypriceapi.com/v2/rates/latest",
    "params": "symbols",
    "headers": "x-api-key",
    "parse": "rates.{symbol}",
    "timestamp": "timestamp",
    "apiKeyEnvVar": "COMMODITY_PRICE_API_KEY",
    "assets": ["XAU", "XAG"]
  },
  "TwelveData": {
    "url": "https://api.twelvedata.com/price",
    "params": "apikey,symbol",
    "parse": "{symbol}.price",
    "apiKeyEnvVar": "TWELVEDATA_API_KEY",
    "comment": "Uses stock price feeds as a proxy for xStock / Robinhood stock assets (SPY, SPYX, TSLA, TSLAX).",
    "assets": ["XAU", "XAG", "SPY", "SPYX", "TSLA", "TSLAX"],
    "symbolMapping": {
      "XAU": "XAU/USD",
      "XAG": "XAG/USD",
      "SPY": "SPY",
      "SPYX": "SPY",
      "TSLA": "TSLA",
      "TSLAX": "TSLA"
    }
  },
  "OANDA": {
    "url": "https://api-fxpractice.oanda.com/v3/accounts/${ACCOUNT_ID}/pricing",
    "params": "instruments",
    "headers": "Authorization",
    "parse": "oanda.prices",
    "apiKeyEnvVar": "OANDA_API_KEY",
    "accountIdEnvVar": "OANDA_ACCOUNT_ID",
    "comment": "Practice API. Use api-fxtrade.oanda.com for live",
    "assets": ["XAU", "XAG"],
    "symbolMapping": {
      "XAU": "XAU_USD",
      "XAG": "XAG_USD"
    }
  },
  "constant": {
    "parse": "constant",
    "assets": ["USDST"]
  }
}
