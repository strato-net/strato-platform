# ---- GitHub (bot machine account) -------------------------------------------
# Token of the bot's machine account (must have Write access to the repo so it
# can be assigned issues and push branches). Classic PAT: scopes `repo` +
# `read:org`. Fine-grained PAT (resource owner = strato-net): Issues R/W,
# Pull requests R/W, Contents R/W, Metadata R + org Members: read.
# Leave empty for an anonymous read-only smoke test (forces DRY_RUN=true and
# needs GITHUB_BOT_LOGIN).
GITHUB_TOKEN=
GITHUB_OWNER=strato-net
GITHUB_REPO=strato-platform
#GITHUB_BOT_LOGIN=            # auto-detected from the token
BASE_BRANCH=develop
BRANCH_PREFIX=tracking-bot/
OPEN_PULL_REQUEST=true
CORE_TEAM_SLUG=core           # org team slug whose members may file work
#CORE_TEAM_MEMBERS=alice,bob  # fallback allowlist when the token cannot read teams
TRIAGE_LABELS=tracking,tracking-server,tracking-ui
TRIAGE_USE_AI=true
TRIAGE_SKIP_HUMAN_ASSIGNED=true  # leave issues a human already owns alone (assign the bot explicitly to override)
TRIAGE_LOOKBACK_DAYS=14          # first poll classifies issues updated within this window
BOT_LABEL_PREFIX=tracking-bot
#ISSUE_ALLOWLIST=7352,7360   # only touch these issues (staged rollout / smoke test)

# ---- Models -------------------------------------------------------------------
# <provider>:<model>; providers: anthropic | openai | xai | openai-compatible
TRIAGE_MODEL=anthropic:claude-opus-5
IMPLEMENT_MODEL=anthropic:claude-opus-5
MODEL_EFFORT=high             # low | medium | high | xhigh | max
ANTHROPIC_API_KEY=
#OPENAI_API_KEY=              # e.g. IMPLEMENT_MODEL=openai:gpt-5.2-codex
#OPENAI_REASONING_EFFORT=     # override for OpenAI models (low|medium|high|xhigh)
#XAI_API_KEY=                 # e.g. IMPLEMENT_MODEL=xai:grok-4
#XAI_BASE_URL=https://api.x.ai/v1
#XAI_REASONING_EFFORT=
#OPENAI_COMPAT_BASE_URL=      # any other OpenAI-compatible endpoint
#OPENAI_COMPAT_API_KEY=
AGENT_MAX_TURNS=250
AGENT_MAX_FIX_ROUNDS=3
CI_MAX_FIX_ROUNDS=3

# ---- Workspace ----------------------------------------------------------------
WORKSPACE_DIR=/var/lib/tracking-bot
GIT_AUTHOR_NAME=STRATO Tracking Bot
GIT_AUTHOR_EMAIL=tracking-bot@blockapps.net
ALLOWED_PATHS=app/services/tracking/**,docker-compose.tracking.tpl.yml,BUILD_METADATA
REQUIRED_TEST_PATHS=app/services/tracking/test/**
LOCAL_TESTS=true              # run docker-compose.test.yml before pushing
REGENERATE_BUILD_METADATA=true

# ---- Jenkins (multibranch autobuild job) --------------------------------------
JENKINS_ENABLED=true
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=
JENKINS_JOB=                  # e.g. strato-platform (or folder/strato-platform)
JENKINS_REQUIRED_STAGES=Tracking Server Tests
JENKINS_ACCEPT_UNSTABLE=true
JENKINS_TIMEOUT_MINUTES=240
JENKINS_TRIGGER_AFTER_MINUTES=10

# ---- Deploy (tracking server over SSH) ----------------------------------------
DEPLOY_ENABLED=true
DEPLOY_SSH_HOST=
DEPLOY_SSH_PORT=22
DEPLOY_SSH_USER=ubuntu
#DEPLOY_SSH_KEY_PATH=/run/secrets/tracking-server.pem
#DEPLOY_SSH_KEY=              # or the PEM contents inline (\n allowed)
#DEPLOY_SSH_HOST_FINGERPRINT= # optional SHA256:... pin
DEPLOY_REPO_DIR=/home/ubuntu/strato-platform
DEPLOY_COMPOSE_FILE=docker-compose.tracking.yml
#DEPLOY_ENV_FILE=             # passed as --env-file to docker compose
#DEPLOY_COMPOSE_PROFILES=     # e.g. local-db
DEPLOY_MAKE_TARGETS=tracking tracking-nginx tracking-ui docker-compose
DEPLOY_HEALTH_URL=https://go.strato.nexus/health
#DEPLOY_COMMAND=              # full override; {branch} {sha} {repoDir} substituted
DEPLOY_TIMEOUT_MINUTES=40

# ---- Bot ------------------------------------------------------------------------
POLL_INTERVAL_SECONDS=60
PORT=3020
DRY_RUN=false                 # true: read GitHub, never write/push/deploy
