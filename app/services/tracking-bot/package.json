{
  "name": "strato-tracking-bot",
  "version": "1.0.0",
  "private": true,
  "description": "CI/CD bot for the STRATO tracking server: triages GitHub issues, implements them with an LLM agent on a feature branch, waits for Jenkins, and deploys to the tracking server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-reporter=spec dist/**/*.test.js",
    "provision": "ts-node --transpile-only infra/provision.ts"
  },
  "engines": {
    "node": ">=22.12 <23.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@octokit/rest": "^22.0.0",
    "dotenv": "^16.4.5",
    "openai": "^7.5.0",
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@types/node": "^22.15.0",
    "@types/ssh2": "^1.15.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
