{
  "name": "strato-v3-liquidity-manager-service",
  "version": "1.0.0",
  "description": "Monitors corporate V3 ladder positions for drift against the oracle price and alerts (email/webhook) when repositioning is needed",
  "main": "src/index.ts",
  "scripts": {
    "start": "ts-node src/index.ts",
    "once": "ts-node src/index.ts --once",
    "dev": "nodemon src/index.ts",
    "build": "tsc"
  },
  "engines": {
    "node": ">=22.12 <23.0"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
