# STRATO node / app base url (the service calls <NODE_URL>/api; a trailing /api is also accepted)
NODE_URL=https://app.testnet.strato.nexus

# Corporate accounts to monitor and the pools each holds ladders in:
#   ACCOUNT_POOLS="<account>=<pool>,<pool>; <account2>=<pool>"
# Every account-pool pair is checked (and alerted on) independently. Account
# addresses are read identities only (X-Wallet-Address header) — no key, no OTP.
ACCOUNT_POOLS=3b23c91aedc1c0f4ad442c7248f6e49cc1547c1d=074239f5d943734a45a0f31fa249da1c3d8ff919

# --- drift tuning ---
# ε = EPSILON_FACTOR × the innermost layer's half-width (per pool, auto-derived).
# 0.75 alerts before the inner layer actually exits range.
EPSILON_FACTOR=0.75
# Or pin an absolute ε in percent (overrides EPSILON_FACTOR when set):
# EPSILON_ABS_PCT=1.5

# Pool price vs oracle divergence that raises a dislocation warning, in percent
DISLOCATION_PCT=3

# Canonical ladder widths per pool, used verbatim in the reposition command of alerts.
# Without this, widths are reconstructed from chain state, which includes tick-snapping
# and slowly widens the ladder over repeated repositions.
# LADDER_WIDTHS=074239f5d943734a45a0f31fa249da1c3d8ff919=1.5,4,10,20,40; <goldPool>=1,3,7,15,35

POLL_INTERVAL_SECONDS=300
# While a condition persists, re-alert only after this many hours (or if drift doubles)
ALERT_COOLDOWN_HOURS=6

# --- notification channels (configure at least one) ---
# Email via SendGrid (same key the backend contact form uses).
# ALERT_EMAIL_FROM must be a sender/domain verified on the SendGrid account —
# no-reply@strato.nexus is the one the backend already sends from.
SENDGRID_API_KEY=
ALERT_EMAIL_FROM=no-reply@strato.nexus
ALERT_EMAIL_TO=you@yourdomain.example

# Slack incoming-webhook url
SLACK_WEBHOOK_URL=

# --- service ---
HEALTH_PORT=3007
# STATE_FILE=/var/lib/v3-liquidity-manager/state.json
