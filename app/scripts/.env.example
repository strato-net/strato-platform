# The target is given on the command line: --network <testnet|prod>
# --vault <saveusdst|eth|wbtc|usdc|goldst|silvst|hype>.

# OAuth client the rewards-poller account belongs to
OAUTH_URL=https://your-idp/.well-known/openid-configuration
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_TOTP=your-current-one-time-code

# Credentials of the live deployed rewards-poller service account: every batch
# is posted as this identity.
POLLER_NAME=your-poller-username
POLLER_PASSWORD=your-poller-password

# Optional admin (same OAuth client). The run phase casts the first vote on each
# governed call as this account and then waits for the second admin; leave unset
# to have the run phase only announce the calls and wait for SMD.
# ADMIN_NAME=
# ADMIN_PASSWORD=

# Optional run-phase settings
# RESTORE_EMISSION_RATE=   # rate restored after reconciliation (default: the live rate before freezing)
# VOTE_TIMEOUT_MS=3600000  # how long to wait for each governed call to execute

# Optional OAuth scope
# OAUTH_SCOPE=

# Optional profile overrides
# NODE_URL=
# REWARDS_ADDRESS=
# VAULT_ADDRESS=
# ACTIVITY_ID=
# VAULT_KIND=            # yield | save
# CUSTODY_ADDRESSES=     # comma-separated native custody vault(s)
# ADMIN_REGISTRY_ADDRESS=

# Optional: use a bearer token instead of username/password
# POLLER_TOKEN=
