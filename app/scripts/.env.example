# Reconciliation target: testnet or prod
NETWORK=testnet
VAULT=eth

# Only this vault may receive a non-zero emission rate after reconciliation
EMISSION_VAULT=eth

# OAuth client the rewards-poller account belongs to
OAUTH_URL=https://your-idp/.well-known/openid-configuration
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
# OAUTH_TOTP=your-current-one-time-code

# Credentials of the live deployed rewards-poller service account. This is the
# only identity the script uses; admin actions are performed in SMD.
POLLER_NAME=your-poller-username
POLLER_PASSWORD=your-poller-password

# Optional OAuth scope
# OAUTH_SCOPE=

# Optional profile overrides
# NODE_URL=
# REWARDS_ADDRESS=
# VAULT_ADDRESS=
# ACTIVITY_ID=
# ADMIN_REGISTRY_ADDRESS=

# Optional: use a bearer token instead of username/password
# POLLER_TOKEN=
