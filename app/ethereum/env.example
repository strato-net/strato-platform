# Copy to app/ethereum/.env. Fill only the network being deployed.
# Keep runtime credentials, verifier API tokens, KMS ARNs, STRATO OAuth
# credentials and rollout persona settings out of this file.

# Temporary external deployer. Leave blank except while deploying a proxy or
# implementation, then clear it immediately.
PRIVATE_KEY=

# Hardhat RPCs. Fill only the selected network. The generic network:* commands
# choose the correct variable from DEPLOY_ENV and NETWORK exported in the shell.
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
LINEA_SEPOLIA_RPC_URL=
ROBINHOOD_TESTNET_RPC_URL=
MAINNET_RPC_URL=
BASE_RPC_URL=
LINEA_RPC_URL=
ROBINHOOD_RPC_URL=
HYPEREVM_RPC_URL=

# Optional source verification.
ETHERSCAN_API_KEY=
BLOCKSCOUT_API_KEY=

# Optional legacy Mercata DepositRouter discovery only. The current
# bridge:prepare --discover workflow does not require this.
ALCHEMY_API_KEY=

# EAB vault/router deployment example for Sepolia. Keep exactly one selected
# chain block in the real .env and replace 11155111 with that chain's ID.
# CHAIN_<ID>_RPC_URL normally has the same value as the selected Hardhat RPC.
CHAIN_11155111_RPC_URL=
CHAIN_11155111_DEPLOYMENT_CONFIRMATIONS=
CHAIN_11155111_SAFE_ADDRESS=
CHAIN_11155111_VAULT_DEFAULT_ADMIN_ADDRESS=
CHAIN_11155111_VAULT_UPGRADER_ADDRESS=
CHAIN_11155111_VAULT_POLICY_ADMIN_ADDRESS=
CHAIN_11155111_GUARDIAN_ADDRESS=
CHAIN_11155111_VAULT_UNPAUSER_ADDRESS=
CHAIN_11155111_VAULT_ATTESTATION_ADMIN_ADDRESS=
CHAIN_11155111_LARGE_WITHDRAWAL_APPROVER_ADDRESS=

# Optional. Omit to use canonical Permit2.
# CHAIN_11155111_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3

# Required only when executing a production EAB deployment. Set it to the exact
# selected production chain ID immediately before --execute.
CONFIRM_EXTERNAL_BRIDGE_DEPLOY=

# CONTRACT_NAME and INIT_PARAMS are command-scoped inputs. Pass them directly on
# network:deploy-proxy or network:deploy-implementation commands; do not store
# them here.
