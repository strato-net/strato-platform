# Minimal env for native bridge deployment on Sepolia
# Required by the current deployWithProxy:sepolia flow
PRIVATE_KEY=YOUR_PRIVATE_KEY
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: only needed if you want to verify on Etherscan
ETHERSCAN_API_KEY=

# External Asset Bridge pair deployment on the selected Hardhat network
# Production execution requires the exact chain ID: 1, 8453, or 59144.
CONFIRM_EXTERNAL_BRIDGE_DEPLOY=

# Sepolia EAB deployment, rollout validation, and execution
CHAIN_11155111_SAFE_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_DEFAULT_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_UPGRADER_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_POLICY_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_GUARDIAN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_UNPAUSER_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_ATTESTATION_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_LARGE_WITHDRAWAL_APPROVER_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
CHAIN_11155111_EXTERNAL_BRIDGE_SIGNER_ADDRESSES=0xSIGNER_1,0xSIGNER_2,0xSIGNER_3
CHAIN_11155111_EXTERNAL_BRIDGE_SIGNER_URLS=https://signer-1.example,https://signer-2.example,https://signer-3.example
CHAIN_11155111_EXTERNAL_BRIDGE_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_EXTERNAL_BRIDGE_EXECUTOR_KMS_URL=https://kms-signing-adapter.example/sign-transaction
CHAIN_11155111_EXTERNAL_BRIDGE_EXECUTOR_KMS_API_TOKEN=

