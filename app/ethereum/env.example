# Passed on the CLI, not normally stored in .env:
# CONTRACT_NAME=StratoNativeRepresentationToken
# INIT_PARAMS='["Wrapped Native STRATO","wSTRATO","0xSAFE_ADDRESS"]'

# Additional RPC URLs for other networks / flows
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
MAINNET_RPC_URL=https://ethereum-rpc.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
LINEA_RPC_URL=https://rpc.linea.build
LINEA_SEPOLIA_RPC_URL=https://rpc.sepolia.linea.build
BASESCAN_API_KEY=

# Robinhood Chain (DepositRouter / bridge custody setup)
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# DepositRouter / Safe tooling
ALCHEMY_API_KEY=
ROUTER_IMPL_ETH=
ROUTER_IMPL_BASE=
ROUTER_IMPL_LINEA=
SAFE_PROPOSER_ADDRESS=0x0000000000000000000000000000000000000000
# Manual DepositRouter deployment/upgrade tooling only. The long-running bridge
# service uses SAFE_PROPOSER_KMS_KEY_ID and never loads this private key.
SAFE_PROPOSER_PRIVATE_KEY=
SAFE_API_KEY=
DEPOSIT_ROUTER_ADDRESS=

# Generic node / auth (used by scripts that query STRATO/Cirrus)
NODE_URL=
BA_USERNAME=
BA_PASSWORD=
CLIENT_ID=
CLIENT_SECRET=
OPENID_DISCOVERY_URL=
ACCESS_TOKEN=
