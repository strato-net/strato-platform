# Copy to app/ethereum/.env and edit for the selected environment.
# Leave PRIVATE_KEY blank for tests; resolve it only for external deployment, then clear it.
PRIVATE_KEY=
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: only needed if you want to verify on Etherscan
ETHERSCAN_API_KEY=

# Deployment command inputs. Use literal absolute paths, no variable expansion.
# Source this file only inside command subshells, never before service Compose commands.
# Select mainnet, sepolia, base, baseSepolia, linea, or lineaSepolia before deployment.
HARDHAT_NETWORK=hardhat
EAB_ROLLOUT_DIRECTORY='REVIEW_REQUIRED'
EAB_CONFIG_DIRECTORY='REVIEW_REQUIRED'
SOURCE_CHAIN_ID='REVIEW_REQUIRED'
EXTERNAL_CHAIN_ID='REVIEW_REQUIRED'
ADMIN_REGISTRY_ADDRESS='REVIEW_REQUIRED'
SAFE_ADDRESS='REVIEW_REQUIRED'
TOKEN_ROUTER_PROXY='REVIEW_REQUIRED'
EXTERNAL_ASSET_BRIDGE_PROXY='REVIEW_REQUIRED'
BRIDGE_CONFIG='REVIEW_REQUIRED'
VAULT_CONFIG='REVIEW_REQUIRED'
ROLLOUT_MANIFEST='REVIEW_REQUIRED'
BRIDGE_TAG='REVIEW_REQUIRED'
NGINX_TAG='REVIEW_REQUIRED'
EAB_HELPER_MANIFEST='REVIEW_REQUIRED'
STAGE='initialize'
START_CALL='1'
VAULT_IMPLEMENTATION='REVIEW_REQUIRED'
ROUTER_IMPLEMENTATION='REVIEW_REQUIRED'
APPROVAL_HASH='REVIEW_REQUIRED'
WITHDRAWAL_ID='REVIEW_REQUIRED'
EAB_TOOL_KMS_REGION='REVIEW_REQUIRED'
EAB_TOOL_KMS_KEY_ID='REVIEW_REQUIRED'
EAB_KEY_DESCRIPTION='REVIEW_REQUIRED'
EAB_KEY_POLICY_FILE='REVIEW_REQUIRED'
# Record external contract outputs after deployment.
DEPOSIT_ROUTER_PROXY=
EXTERNAL_BRIDGE_VAULT_PROXY=
DEPOSIT_ROUTER_DEPLOYMENT_BLOCK=
EXTERNAL_BRIDGE_DEPLOYMENT_JSON=
USDST_ADDRESS=

# External Asset Bridge pair deployment on the selected Hardhat network
# Production execution requires the exact chain ID: 1, 8453, or 59144.
CONFIRM_EXTERNAL_BRIDGE_DEPLOY=

# Configure only the selected chain. Use full immutable KMS key ARNs and unique
# verifier API tokens of at least 32 characters; addresses must match approved policy.
# Sepolia EAB deployment, rollout validation, and execution
# Fill RPC_URL from the same provider as the selected Hardhat RPC variable.
CHAIN_11155111_RPC_URL=
CHAIN_11155111_DEPLOYMENT_CONFIRMATIONS=REVIEW_REQUIRED
CHAIN_11155111_SAFE_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_DEFAULT_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_UPGRADER_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_POLICY_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_GUARDIAN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_UNPAUSER_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_VAULT_ATTESTATION_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_LARGE_WITHDRAWAL_APPROVER_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
CHAIN_11155111_VAULT_AUTHORIZATION_SIGNER_ADDRESSES=0xSIGNER_1,0xSIGNER_2,0xSIGNER_3
CHAIN_11155111_EXTERNAL_BRIDGE_VERIFIER_URLS=https://verifier-1.example,https://verifier-2.example,https://verifier-3.example
CHAIN_11155111_EXTERNAL_BRIDGE_VERIFIER_API_TOKENS=
CHAIN_11155111_EXTERNAL_BRIDGE_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000000
CHAIN_11155111_EXTERNAL_BRIDGE_EXECUTOR_KMS_KEY_ID=
CHAIN_11155111_EXTERNAL_BRIDGE_EXECUTOR_KMS_REGION=us-east-1

