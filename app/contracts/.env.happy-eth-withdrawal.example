# Non-native ETH withdrawal smoke runner env
# Copy to .env.happy-eth-withdrawal and fill in real values.

# Existing non-native STRATO bridge
BRIDGE_ADDRESS=

# ETH route on Sepolia
EXTERNAL_CHAIN_ID=11155111
CHAIN_11155111_RPC_URL=
STRATO_ETH_TOKEN_ADDRESS=0x93fb7295859b2d70199e0a4883b7c320cf874e6c
EXTERNAL_RECIPIENT_ADDRESS=

# STRATO account that holds the mapped ETH token and will request withdrawal
STRATO_WITHDRAWER_ADDRESS=
STRATO_WITHDRAWER_NAME=
STRATO_WITHDRAWER_PASSWORD=
WITHDRAWAL_AMOUNT_WEI=
REQUIRE_MANUAL_WITHDRAWAL=true

# Optional polling overrides
HAPPY_PATH_TIMEOUT_MS=600000
HAPPY_PATH_POLL_INTERVAL_MS=10000

# STRATO API auth used by contract calls and Cirrus reads
NODE_URL=
OAUTH_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
