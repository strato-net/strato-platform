    function beforeEach() {
        lc = new EthLightClient(address(this));
        lc.bootstrap(
            _bootstrapPeriod(),
            _sepoliaCommittee(),
            _gvr(),
            _forkVersion()
        );
        // Real period-1243 aggregate_pubkey. Lets the verifier reach the
        // subset aggregate by subtracting the 42 non-signers rather than
        // summing the 470 signers.
        lc.setCommitteeAggregate(_bootstrapPeriod(), _aggregatePubkey());
    }

    /**
     * @notice The acid test. Anchor a real Sepolia finalized block.
     */
    function it_anchors_real_sepolia_finalized_header_end_to_end() {
        SyncAggregateInput sync = SyncAggregateInput({
            participationBits: _participationBits(),
            signature:         _signature(),
            signatureSlot:     uint64(10182913)
        });
        // parentChain empty: target = finalizedHeader (today's behavior).
        BeaconBlockHeaderInput[] noParents = new BeaconBlockHeaderInput[](0);
        uint256 anchored = lc.anchorBlockHeader(_headers(), sync, noParents, _eph(), _executionBranch());
        require(anchored == 10790533, "anchored block number mismatch");
        require(lc.isAnchored(10790533), "isAnchored should be true");
        require(
            lc.getReceiptsRoot(10790533) ==
                bytes32(hex"079d81c599aef8f01e94e08348c67147eff4d4319cea20fd488d5ed6a5fd1eaa"),
            "receiptsRoot mismatch"
        );
    }
