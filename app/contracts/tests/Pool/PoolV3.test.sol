        require(a0 == int(10e18), "amount0 delta should be +10e18");
        require(a1 == -9969006090092817746, "amount1 delta mismatch: " + string(a1));
        require(bal0Before - ERC20(token0Address).balanceOf(address(this)) == 10e18, "Full input should be pulled");
        require(ERC20(token1Address).balanceOf(address(this)) == bal1Before + 9969006090092817746, "Output not received");

        // CANONICAL post-swap state
        require(pool.sqrtPriceX96() == 79220264253918221946815852796, "Post-swap sqrt price mismatch: " + string(pool.sqrtPriceX96()));
