    // ============ SYNC / SKIM TESTS ============

    function it_skim_recovers_donated_tokens() {
        _mintRange(-600, 600, 1000e18);
        uint tracked0 = pool.token0Balance();
        uint tracked1 = pool.token1Balance();

        Token(token0Address).mint(poolAddress, 5e18);
        Token(token1Address).mint(poolAddress, 7e18);
        require(ERC20(token0Address).balanceOf(poolAddress) == tracked0 + 5e18, "Donation 0 should land");

        User receiver = new User();
        pool.skim(address(receiver));
        require(ERC20(token0Address).balanceOf(address(receiver)) == 5e18, "Skim should pay excess 0");
        require(ERC20(token1Address).balanceOf(address(receiver)) == 7e18, "Skim should pay excess 1");
        require(pool.token0Balance() == tracked0 && pool.token1Balance() == tracked1, "Tracked balances must not change");
        require(ERC20(token0Address).balanceOf(poolAddress) == tracked0, "Pool 0 balance should match tracked");

        pool.burn(-600, 600, 1000e18, block.timestamp + DEADLINE_OFFSET);
        (uint got0, uint got1) = pool.collect(address(this), -600, 600, BIG, BIG);
        require(got0 > 0 && got1 > 0, "Exit after skim should work");
    }

    function it_sync_repairs_tracked_balances() {
        _mintRange(-600, 600, 1000e18);
        Token(token0Address).mint(poolAddress, 5e18);

        factory.syncPools([poolAddress]);
        require(pool.token0Balance() == ERC20(token0Address).balanceOf(poolAddress), "Sync should adopt actual 0 balance");
        require(pool.token1Balance() == ERC20(token1Address).balanceOf(poolAddress), "Sync should adopt actual 1 balance");

        User receiver = new User();
        factory.skimPools([poolAddress], address(receiver));
        require(ERC20(token0Address).balanceOf(address(receiver)) == 0, "Nothing to skim after sync");
    }

    function it_sync_skim_reject_strangers() {
        _mintRange(-600, 600, 1000e18);
        User stranger = new User();

        bool thrown = false;
        try {
            stranger.do(poolAddress, "skim", address(stranger));
        } catch {
            thrown = true;
        }
        require(thrown, "Stranger skim should revert");

        thrown = false;
        try {
            stranger.do(poolAddress, "sync");
        } catch {
            thrown = true;
        }
        require(thrown, "Stranger sync should revert");
    }

    // ============ FACTORY MIGRATION TESTS ============

    function it_transfer_pool_to_new_factory() {
        PoolV3Factory factory2 = new PoolV3Factory(address(this));
        factory2.initialize(address(m.tokenFactory()), address(m.feeCollector()));

        pool.transferPoolToFactory(address(factory2));
        require(address(pool.poolV3Factory()) == address(factory2), "Factory pointer should update");

        // Old factory loses admin rights over the pool
        bool thrown = false;
        try {
            factory.setPoolFeeProtocol(poolAddress, 6, 6);
        } catch {
            thrown = true;
        }
        require(thrown, "Old factory should lose pool admin");

        // New factory gains them
        factory2.setPoolFeeProtocol(poolAddress, 4, 4);
        require(pool.feeProtocol() == 4 + (4 << 4), "New factory should administer the pool");

        // The new factory adopts the pool into its registry
        factory2.registerPoolsFromFactory([poolAddress]);
        require(factory2.pools(token0Address, token1Address, 3000) == poolAddress, "Registry should adopt the pool");
        require(factory2.pools(token1Address, token0Address, 3000) == poolAddress, "Reverse registry should adopt the pool");

        thrown = false;
        try {
            factory2.createPoolV3(token0Address, token1Address, 3000, Q96);
        } catch {
            thrown = true;
        }
        require(thrown, "Duplicate creation after adoption should revert");

        thrown = false;
        try {
            pool.transferPoolToFactory(address(0));
        } catch {
            thrown = true;
        }
        require(thrown, "Zero factory address should revert");
    }

    function it_factory_batch_migration_with_registry_adoption() {
        address pool10000 = factory.createPoolV3(token0Address, token1Address, 10000, Q96);

        PoolV3Factory factory2 = new PoolV3Factory(address(this));
        factory2.initialize(address(m.tokenFactory()), address(m.feeCollector()));

        bool thrown = false;
        try {
            factory2.registerPoolsFromFactory([poolAddress]);
        } catch {
            thrown = true;
        }
        require(thrown, "Adopting a foreign pool should revert");

        factory.transferPoolsToFactory(address(factory2));
        require(address(pool.poolV3Factory()) == address(factory2), "Pool 1 should point at factory2");
        require(address(PoolV3(pool10000).poolV3Factory()) == address(factory2), "Pool 2 should point at factory2");

        factory2.registerPoolsFromFactory([poolAddress, pool10000]);
        require(factory2.pools(token0Address, token1Address, 3000) == poolAddress, "0.3% pool adopted");
        require(factory2.pools(token0Address, token1Address, 10000) == pool10000, "1% pool adopted");

        factory2.registerPoolsFromFactory([poolAddress]);
        require(factory2.pools(token0Address, token1Address, 3000) == poolAddress, "Re-registration stays consistent");
    }
