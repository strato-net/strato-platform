    function property_mint_burn_roundtrip_never_profits(uint seed) {
        int tickLower = -60 * int(1 + seed % 50);
        int tickUpper = 60 * int(1 + (seed / 50) % 50);
        uint liquidityAmount = 1e18 + (seed % 1000) * 1e18;

        (uint deposited0, uint deposited1) = _mintRange(tickLower, tickUpper, liquidityAmount);
        (uint burned0, uint burned1) = pool.burn(tickLower, tickUpper, liquidityAmount, block.timestamp + DEADLINE_OFFSET);

        require(burned0 <= deposited0, "Burn must not return more token0 than deposited");
        require(burned1 <= deposited1, "Burn must not return more token1 than deposited");
        require(deposited0 - burned0 <= 4, "Excessive token0 rounding loss: " + string(deposited0 - burned0));
        require(deposited1 - burned1 <= 4, "Excessive token1 rounding loss: " + string(deposited1 - burned1));

        (uint got0, uint got1) = pool.collect(address(this), tickLower, tickUpper, BIG, BIG);
        require(got0 == burned0 && got1 == burned1, "Collect should pay exactly what burn credited");
    }

    function property_swap_roundtrip_never_profits(uint seed) {
        _mintRange(-12000, 12000, 200000e18);
        uint amountIn = 1e15 + seed % 5000e18;

        uint bal0Before = ERC20(token0Address).balanceOf(address(this));
        uint bal1Before = ERC20(token1Address).balanceOf(address(this));

        uint outB = _swap(true, amountIn);
        uint backA = _swap(false, outB);

        require(backA < amountIn, "Swap round trip must never profit: in " + string(amountIn) + " back " + string(backA));
        require(ERC20(token1Address).balanceOf(address(this)) == bal1Before, "All token1 should be swapped back");
        require(ERC20(token0Address).balanceOf(address(this)) == bal0Before - amountIn + backA, "Token0 accounting wrong");
    }

