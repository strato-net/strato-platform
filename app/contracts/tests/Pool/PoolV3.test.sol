import "../../concrete/BaseCodeCollection.sol";
import "../../concrete/Pools/PoolV3Factory.sol";
import "../../abstract/ERC20/access/Authorizable.sol";

/*
 * PoolV3 test suite — canonical Uniswap V3 parity.
 *
 * Every pinned constant below is generated by tests/Pool/poolv3_reference.py, which
 * replicates canonical Uniswap V3 integer math (TickMath, SqrtPriceMath, SwapMath,
 * the tick-crossing swap loop) exactly. Values marked CANONICAL are therefore the
 * bit-for-bit outputs of UniswapV3Pool.sol for the same inputs.
 */

contract User {
    function do(address a, string f, variadic args) public returns (variadic) {
        variadic result = address(a).call(f, args);
        return result;
    }
}

/// @notice flash() borrower fixture. `mode` selects how the callback settles:
///         0 repay principal + fee, 1 repay principal only (short the fee), 2 repay principal +
///         fee + 1e18 token0 (overpay), 3 try to re-enter flash, 4 try to re-enter swap,
///         5 try to re-enter mint, 6 try to re-enter burn, 7 try to re-enter collect,
///         8 try to re-enter sync, 9 try to re-enter skim, 10 spend the borrowed token0 on `other`
///         (a V2 Pool of the same pair) and repay from float
contract FlashBorrower {
    PoolV3 pool;
    address token0;
    address token1;
    uint public mode;
    uint public amount0;
    uint public amount1;
    uint public lastFee0;
    uint public lastFee1;
    string public lastNote;
    /// @dev another pool the callback trades on in mode 10 (flash-funded cross-venue swap)
    address public other;

    function init(address _pool, address _token0, address _token1) public {
        pool = PoolV3(_pool);
        token0 = _token0;
        token1 = _token1;
    }

    function setOther(address _other) public {
        other = _other;
    }

    function go(address recipient, uint _amount0, uint _amount1, uint _mode) public {
        mode = _mode;
        amount0 = _amount0;
        amount1 = _amount1;
        pool.flash(recipient, _amount0, _amount1, "note");
    }

    function poolV3FlashCallback(uint fee0, uint fee1, variadic data) external {
        require(msg.sender == address(pool), "FlashBorrower: bad pool");
        lastFee0 = fee0;
        lastFee1 = fee1;
        lastNote = string(data[0]);

        if (mode == 10) {
            // spend the borrowed token0 on the V2 pool of the same pair, then repay from float
            require(Token(token0).approve(other, amount0), "approve other failed");
            Pool(other).swap(true, amount0, 1, block.timestamp + 3600);
        }

        if (mode == 3) pool.flash(address(this), 1, 0, "nested");
        if (mode == 4) pool.swap(address(this), true, 1, 0, 1, block.timestamp + 3600);
        if (mode == 5) pool.mint(address(this), -60, 60, 1, 1, 1, block.timestamp + 3600);
        if (mode == 6) pool.burn(-6000, 6000, 0, block.timestamp + 3600);
        if (mode == 7) pool.collect(address(this), -6000, 6000, 1, 1);
        if (mode == 8) pool.sync();
        if (mode == 9) pool.skim(address(this));

        uint repay0 = mode == 1 ? amount0 : amount0 + fee0;
        uint repay1 = mode == 1 ? amount1 : amount1 + fee1;
        if (mode == 2) repay0 += 1e18;
        if (repay0 > 0) require(Token(token0).transfer(address(pool), repay0), "repay0 failed");
        if (repay1 > 0) require(Token(token1).transfer(address(pool), repay1), "repay1 failed");
    }
}

contract Describe_PoolV3 is Authorizable {

    Mercata m;
    string[] emptyArray;

    PoolV3Factory factory;
    address token0Address;
    address token1Address;
    address poolAddress;
    PoolV3 pool;

    // CANONICAL: TickMath constants
    uint constant Q96 = 79228162514264337593543950336;
    uint constant Q128 = 340282366920938463463374607431768211456;
    uint constant MIN_SQRT_RATIO = 4295128739;
    uint constant MAX_SQRT_RATIO = 1461446703485210103287273052203988822378723970342;
    int constant MIN_TICK = -887272;
    int constant MAX_TICK = 887272;

    uint constant DEADLINE_OFFSET = 3600;
    uint constant BIG = 100000000e18;

    function beforeAll() {
        bypassAuthorizations = true;
        m = new Mercata();
        require(address(m) != address(0), "Mercata address is 0");
        emptyArray = new string[](0);
    }

    function beforeEach() {
        // Create fresh tokens for each test
        token0Address = m.tokenFactory().createToken(
            "Token 0", "Test Token 0", emptyArray, emptyArray, emptyArray, "TK0", 10000000e18, 18
        );
        token1Address = m.tokenFactory().createToken(
            "Token 1", "Test Token 1", emptyArray, emptyArray, emptyArray, "TK1", 10000000e18, 18
        );

        // Activate tokens
        Token(token0Address).setStatus(2); // ACTIVE
        Token(token1Address).setStatus(2); // ACTIVE

        // Mint tokens to test contract
        Token(token0Address).mint(address(this), BIG);
        Token(token1Address).mint(address(this), BIG);

        // Create standalone V3 factory owned by this test contract
        factory = new PoolV3Factory(address(this));
        factory.initialize(address(m.tokenFactory()), address(m.feeCollector()));

        // Create pool at the 0.30% tier (3000 pips) with initial price 1.0 (sqrtPriceX96 = 2^96, tick 0)
        poolAddress = factory.createPoolV3(token0Address, token1Address, 3000, Q96);
        pool = PoolV3(poolAddress);

        // Flash tests pin fees at the swap tier; the contract default is zero
        // (see it_flash_fee_defaults_to_zero)
        factory.setPoolFlashFee(poolAddress, 3000);
    }

    // ============ HELPERS ============

    function _approveBoth(uint amount0, uint amount1) internal {
        require(ERC20(token0Address).approve(address(pool), amount0), "Token0 approval failed");
        require(ERC20(token1Address).approve(address(pool), amount1), "Token1 approval failed");
    }

    function _mintRange(int tickLower, int tickUpper, uint liquidityAmount) internal returns (uint, uint) {
        _approveBoth(BIG, BIG);
        return pool.mint(address(this), tickLower, tickUpper, liquidityAmount, BIG, BIG, block.timestamp + DEADLINE_OFFSET);
    }

    /// @dev Exact-input swap; returns the output amount received
    function _swap(bool zeroForOne, uint amountIn) internal returns (uint) {
        address tokenIn = zeroForOne ? token0Address : token1Address;
        require(ERC20(tokenIn).approve(address(pool), amountIn), "Swap approval failed");
        (int a0, int a1) = pool.swap(address(this), zeroForOne, int(amountIn), 0, 1, block.timestamp + DEADLINE_OFFSET);
        return uint(-(zeroForOne ? a1 : a0));
    }

    /// @dev Exact-output swap; returns the input amount paid
    function _swapExactOut(bool zeroForOne, uint amountOut, uint maxIn) internal returns (uint) {
        address tokenIn = zeroForOne ? token0Address : token1Address;
        require(ERC20(tokenIn).approve(address(pool), maxIn), "Swap approval failed");
        (int a0, int a1) = pool.swap(address(this), zeroForOne, -int(amountOut), 0, maxIn, block.timestamp + DEADLINE_OFFSET);
        return uint(zeroForOne ? a0 : a1);
    }

    /// @dev Create a user with token balances and pool approvals for both tokens
    function _newUser() internal returns (User) {
        User u = new User();
        Token(token0Address).mint(address(u), BIG);
        Token(token1Address).mint(address(u), BIG);
        u.do(token0Address, "approve", poolAddress, BIG);
        u.do(token1Address, "approve", poolAddress, BIG);
        return u;
    }

    function _userMint(User u, int tickLower, int tickUpper, uint liquidityAmount) internal {
        u.do(poolAddress, "mint", address(u), tickLower, tickUpper, liquidityAmount, BIG, BIG, block.timestamp + DEADLINE_OFFSET);
    }

    function _userPoke(User u, int tickLower, int tickUpper) internal {
        u.do(poolAddress, "burn", tickLower, tickUpper, 0, block.timestamp + DEADLINE_OFFSET);
    }

    /// @dev Create a flash borrower holding enough of both tokens to pay any fee
    function _newBorrower() internal returns (FlashBorrower) {
        FlashBorrower b = new FlashBorrower();
        b.init(poolAddress, token0Address, token1Address);
        Token(token0Address).mint(address(b), 100e18);
        Token(token1Address).mint(address(b), 100e18);
        return b;
    }

    function _cumulativeNow() internal returns (int) {
        (int tickCum, ) = pool.observeSingle(0);
        return tickCum;
    }

    // ============ FACTORY TESTS ============

    function it_factory_creates_pool_successfully() {
        require(address(pool) != address(0), "Pool should be created");
        require(pool.fee() == 3000, "Fee should be 3000 pips");
        require(pool.tickSpacing() == 60, "Tick spacing should be 60");
        require(pool.sqrtPriceX96() == Q96, "Initial sqrt price should be 2^96");
        require(pool.currentTick() == 0, "Initial tick should be 0");
        require(factory.pools(token0Address, token1Address, 3000) == poolAddress, "Registry 0->1 missing");
        require(factory.pools(token1Address, token0Address, 3000) == poolAddress, "Registry 1->0 missing");
    }

    function it_factory_rejects_duplicate_pool() {
        bool thrown = false;
        try {
            factory.createPoolV3(token0Address, token1Address, 3000, Q96);
        } catch {
            thrown = true;
        }
        require(thrown, "Duplicate pool should revert");
    }

    function it_factory_rejects_unknown_fee_tier() {
        bool thrown = false;
        try {
            factory.createPoolV3(token0Address, token1Address, 777, Q96);
        } catch {
            thrown = true;
        }
        require(thrown, "Unknown fee tier should revert");
    }

    function it_factory_allows_same_pair_different_tier() {
        address pool2 = factory.createPoolV3(token0Address, token1Address, 10000, Q96);
        require(pool2 != address(0) && pool2 != poolAddress, "Second tier pool should be distinct");
        require(PoolV3(pool2).tickSpacing() == 200, "1% tier should use spacing 200");
    }

    function it_factory_rejects_identical_tokens() {
        bool thrown = false;
        try {
            factory.createPoolV3(token0Address, token0Address, 10000, Q96);
        } catch {
            thrown = true;
        }
        require(thrown, "Identical tokens should revert");
    }

    function it_factory_rejects_zero_initial_price() {
        bool thrown = false;
        try {
            factory.createPoolV3(token0Address, token1Address, 10000, 0);
        } catch {
            thrown = true;
        }
        require(thrown, "Zero initial price should revert");
    }

    function it_factory_rejects_inactive_token() {
        Token(token0Address).setStatus(1); // not ACTIVE
        bool thrown = false;
        try {
            factory.createPoolV3(token0Address, token1Address, 10000, Q96);
        } catch {
            thrown = true;
        }
        require(thrown, "Inactive token should revert");
        Token(token0Address).setStatus(2); // restore
    }

    function it_factory_enable_new_fee_tier_and_create_pool() {
        factory.enableFeeTier(550, 11);
        address p550 = factory.createPoolV3(token0Address, token1Address, 550, Q96);
        require(p550 != address(0), "550-pip pool should be created");
        require(PoolV3(p550).fee() == 550, "Fee should be 550 pips");
        require(PoolV3(p550).tickSpacing() == 11, "Tick spacing should be 11");
    }

    function it_factory_fee_tier_validation() {
        bool thrown = false;
        try {
            factory.enableFeeTier(3000, 60); // already exists
        } catch {
            thrown = true;
        }
        require(thrown, "Duplicate fee tier should revert");

        thrown = false;
        try {
            factory.enableFeeTier(0, 60);
        } catch {
            thrown = true;
        }
        require(thrown, "Zero fee should revert");

        thrown = false;
        try {
            factory.enableFeeTier(1000000, 60); // fee must be < 1e6 (canonical bound)
        } catch {
            thrown = true;
        }
        require(thrown, "Fee of 100% should revert");

        thrown = false;
        try {
            factory.enableFeeTier(40, 0);
        } catch {
            thrown = true;
        }
        require(thrown, "Zero tick spacing should revert");

        thrown = false;
        try {
            factory.enableFeeTier(40, 16384); // canonical bound: tickSpacing < 16384
        } catch {
            thrown = true;
        }
        require(thrown, "Tick spacing of 16384 should revert");

        factory.enableFeeTier(40, 16383);
        require(factory.feeTiers(40) == 16383, "Max valid spacing should be accepted");
    }

    function it_factory_non_owner_cannot_admin() {
        User stranger = new User();
        bool thrown = false;
        try {
            stranger.do(address(factory), "createPoolV3", token0Address, token1Address, 10000, Q96);
        } catch {
            thrown = true;
        }
        require(thrown, "Non-owner createPoolV3 should revert");

        thrown = false;
        try {
            stranger.do(address(factory), "enableFeeTier", 40, 60);
        } catch {
            thrown = true;
        }
        require(thrown, "Non-owner enableFeeTier should revert");

        thrown = false;
        try {
            stranger.do(address(factory), "setPoolFeeProtocol", poolAddress, 6, 6);
        } catch {
            thrown = true;
        }
        require(thrown, "Non-owner setPoolFeeProtocol should revert");
    }

    function it_factory_fee_protocol_bounds_and_pool_setting() {
        // CANONICAL setFeeProtocol bounds: each direction 0, or in [4, 10]
        bool thrown = false;
        try {
            factory.setPoolFeeProtocol(poolAddress, 3, 3);
        } catch {
            thrown = true;
        }
        require(thrown, "feeProtocol below 4 should revert");

        thrown = false;
        try {
            factory.setPoolFeeProtocol(poolAddress, 11, 0);
        } catch {
            thrown = true;
        }
        require(thrown, "feeProtocol above 10 should revert");

        // Set per-direction denominators, read back the canonical packed form, reset
        factory.setPoolFeeProtocol(poolAddress, 6, 8);
        require(pool.feeProtocol() == 6 + (8 << 4), "Packed feeProtocol mismatch: " + string(pool.feeProtocol()));
        factory.setPoolFeeProtocol(poolAddress, 0, 0);
        require(pool.feeProtocol() == 0, "feeProtocol reset failed");
    }

    function it_factory_initialize_only_once() {
        bool thrown = false;
        try {
            factory.initialize(address(m.tokenFactory()), address(m.feeCollector()));
        } catch {
            thrown = true;
        }
        require(thrown, "Re-initialize should revert");
        require(factory.feeTiers(3000) == 60, "Factory state must be unchanged");
    }

    function it_factory_create_requires_initialization() {
        // setTokenFactory + enableFeeTier alone must not be enough to mint pools:
        // an uninitialized factory has feeCollector == 0 and must not create pools
        PoolV3Factory bare = new PoolV3Factory(address(this));
        bare.setTokenFactory(address(m.tokenFactory()));
        bare.enableFeeTier(40, 60);

        bool thrown = false;
        try {
            bare.createPoolV3(token0Address, token1Address, 40, Q96);
        } catch {
            thrown = true;
        }
        require(thrown, "Uninitialized factory must not create pools");

        bare.initialize(address(m.tokenFactory()), address(m.feeCollector()));
        address p = bare.createPoolV3(token0Address, token1Address, 40, Q96);
        require(p != address(0), "Initialized factory should create pools");
    }

    // ============ TICK MATH TESTS (canonical TickMath parity) ============

    function it_tick_math_exact_values() {
        // CANONICAL: sqrt(1.0001^0) == 2^96 exactly
        require(pool.getSqrtRatioAtTick(0) == Q96, "Tick 0 should be 2^96");
        // CANONICAL neighbors of tick 0
        require(pool.getSqrtRatioAtTick(1) == 79232123823359799118286999568, "tick 1 mismatch");
        require(pool.getSqrtRatioAtTick(-1) == 79224201403219477170569942574, "tick -1 mismatch");
        // Reciprocal symmetry: p(t) * p(-t) ~ 2^192
        uint p = pool.getSqrtRatioAtTick(100);
        uint n = pool.getSqrtRatioAtTick(-100);
        uint product = (p * n) / Q96;
        require(product >= Q96 - 2 && product <= Q96 + 2, "p(t) * p(-t) should be ~2^192");
    }

    function it_tick_math_matches_uniswap_reference() {
        // CANONICAL: bit-for-bit TickMath.getSqrtRatioAtTick outputs (poolv3_reference.py,
        // constants validated to <1 ULP against a 120-digit reference)
        require(pool.getSqrtRatioAtTick(60) == 79466191966197645195421774833, "tick 60 mismatch");
        require(pool.getSqrtRatioAtTick(-60) == 78990846045029531151608375686, "tick -60 mismatch");
        require(pool.getSqrtRatioAtTick(100) == 79625275426524748796330556128, "tick 100 mismatch");
        require(pool.getSqrtRatioAtTick(-100) == 78833030112140176575862854579, "tick -100 mismatch");
        require(pool.getSqrtRatioAtTick(1000) == 83290069058676223003182343270, "tick 1000 mismatch");
        require(pool.getSqrtRatioAtTick(10000) == 130621891405341611593710811006, "tick 10000 mismatch");
        require(pool.getSqrtRatioAtTick(-10000) == 48055510970269007215549348797, "tick -10000 mismatch");
        require(pool.getSqrtRatioAtTick(887271) == 1461373636630004318706518188784493106690254656249, "tick 887271 mismatch");
        require(pool.getSqrtRatioAtTick(-887271) == 4295343490, "tick -887271 mismatch");
    }

    function it_tick_math_bounds() {
        // CANONICAL: MIN_SQRT_RATIO / MAX_SQRT_RATIO are TickMath's published constants
        require(pool.getSqrtRatioAtTick(MIN_TICK) == MIN_SQRT_RATIO, "MIN_TICK sqrt ratio wrong");
        require(pool.getSqrtRatioAtTick(MAX_TICK) == MAX_SQRT_RATIO, "MAX_TICK sqrt ratio wrong");

        bool thrown = false;
        try {
            pool.getSqrtRatioAtTick(-887273);
        } catch {
            thrown = true;
        }
        require(thrown, "Below MIN_TICK should revert (T)");

        thrown = false;
        try {
            pool.getSqrtRatioAtTick(887273);
        } catch {
            thrown = true;
        }
        require(thrown, "Above MAX_TICK should revert (T)");

        thrown = false;
        try {
            pool.getTickAtSqrtRatio(MIN_SQRT_RATIO - 1);
        } catch {
            thrown = true;
        }
        require(thrown, "Ratio below MIN should revert (R)");

        // Canonical domain is [MIN_SQRT_RATIO, MAX_SQRT_RATIO): the max ratio itself is excluded
        thrown = false;
        try {
            pool.getTickAtSqrtRatio(MAX_SQRT_RATIO);
        } catch {
            thrown = true;
        }
        require(thrown, "Ratio at MAX should revert (R)");
        require(pool.getTickAtSqrtRatio(MAX_SQRT_RATIO - 1) == 887271, "Just below MAX should be tick 887271");
        require(pool.getTickAtSqrtRatio(MIN_SQRT_RATIO) == MIN_TICK, "MIN ratio should be MIN_TICK");
    }

    function it_tick_at_sqrt_ratio_boundary_exact() {
        uint s60 = pool.getSqrtRatioAtTick(60);
        require(pool.getTickAtSqrtRatio(s60) == 60, "Exact boundary should map to its tick");
        require(pool.getTickAtSqrtRatio(s60 - 1) == 59, "1 wei below boundary should map to tick-1");
        require(pool.getTickAtSqrtRatio(s60 + 1) == 60, "1 wei above boundary should stay at tick");
    }

    function property_tick_sqrt_ratio_roundtrip(uint seed) {
        // getTickAtSqrtRatio's domain excludes MAX_SQRT_RATIO, so the roundtrip
        // property holds on [-887272, 887271]
        int tick = int(seed % 1774544) - 887272;
        uint sq = pool.getSqrtRatioAtTick(tick);
        int back = pool.getTickAtSqrtRatio(sq);
        require(back == tick, "Roundtrip failed for tick " + string(tick) + " got " + string(back));
    }

    function property_tick_math_monotonic(uint seed) {
        int tick = int(seed % 1774544) - 887272; // [-887272, 887271]
        require(pool.getSqrtRatioAtTick(tick) < pool.getSqrtRatioAtTick(tick + 1),
            "sqrt ratio not strictly increasing at tick " + string(tick));
    }

    // ============ AMOUNT MATH TESTS ============

    function it_amounts_match_closed_form_reference() {
        // CANONICAL: L=1000e18 over [-600,600) at price 1.0 needs identical amounts of
        // both tokens (symmetric range), rounded up
        (uint amount0, uint amount1) = pool.getAmountsForLiquidity(-600, 600, 1000e18);
        require(amount0 == 29553010879137169681, "amount0 mismatch: " + string(amount0));
        require(amount1 == 29553010879137169681, "amount1 mismatch: " + string(amount1));
    }

    function it_amounts_at_range_boundaries_single_sided() {
        // Price exactly at lower bound: position is in range but needs only token0
        (uint amount0, uint amount1) = pool.getAmountsForLiquidity(0, 60, 100000e18);
        require(amount0 > 0, "Lower boundary should need token0");
        require(amount1 == 0, "Lower boundary should need no token1");

        // Price exactly at upper bound: position is out of range (upper-exclusive), all token1
        (uint amount0b, uint amount1b) = pool.getAmountsForLiquidity(-60, 0, 100000e18);
        require(amount0b == 0, "Upper boundary should need no token0");
        require(amount1b > 0, "Upper boundary should need token1");

        // Liquidity activation matches: [0,60) is active at tick 0, [-60,0) is not
        _mintRange(0, 60, 100000e18);
        require(pool.liquidity() == 100000e18, "[0,60) should be active at tick 0");
        _mintRange(-60, 0, 100000e18);
        require(pool.liquidity() == 100000e18, "[-60,0) should not be active at tick 0");
    }

    function it_mint_dust_liquidity_rounds_up_against_user() {
        // 1 wei of liquidity: both amounts round up to 1 wei (pool never undercharges)
        (uint amount0, uint amount1) = _mintRange(-60, 60, 1);
        require(amount0 == 1, "Dust amount0 should round up to 1");
        require(amount1 == 1, "Dust amount1 should round up to 1");
    }

    // ============ MINT TESTS ============

    function it_mint_in_range_takes_both_tokens() {
        (uint amount0, uint amount1) = _mintRange(-600, 600, 1000e18);
        require(amount0 == 29553010879137169681, "amount0 mismatch: " + string(amount0));
        require(amount1 == 29553010879137169681, "amount1 mismatch: " + string(amount1));
        require(pool.liquidity() == 1000e18, "Pool liquidity should be active");
        require(pool.token0Balance() == amount0, "token0Balance mismatch");
        require(pool.token1Balance() == amount1, "token1Balance mismatch");
    }

    function it_mint_above_range_takes_only_token0() {
        (uint amount0, uint amount1) = _mintRange(600, 1200, 1000e18);
        require(amount0 > 0, "Should need token0");
        require(amount1 == 0, "Should not need token1");
        require(pool.liquidity() == 0, "Out-of-range liquidity should not be active");
    }

    function it_mint_below_range_takes_only_token1() {
        (uint amount0, uint amount1) = _mintRange(-1200, -600, 1000e18);
        require(amount0 == 0, "Should not need token0");
        require(amount1 > 0, "Should need token1");
        require(pool.liquidity() == 0, "Out-of-range liquidity should not be active");
    }

    function it_mint_rejects_bad_ticks() {
        _approveBoth(1000e18, 1000e18);
        bool thrown = false;
        try {
            // 61 is not a multiple of tickSpacing 60
            pool.mint(address(this), -61, 61, 1000e18, 1000e18, 1000e18, block.timestamp + DEADLINE_OFFSET);
        } catch {
            thrown = true;
        }
        require(thrown, "Off-spacing ticks should revert");

        thrown = false;
        try {
            pool.mint(address(this), 600, 600, 1000e18, 1000e18, 1000e18, block.timestamp + DEADLINE_OFFSET);
        } catch {
            thrown = true;
        }
        require(thrown, "Empty range should revert (TLU)");
    }

    function it_mint_rejects_out_of_bounds_ticks() {
        _approveBoth(1000e18, 1000e18);
        bool thrown = false;
        try {
            // -887280 is a multiple of 60 but below MIN_TICK
            pool.mint(address(this), -887280, 600, 1000e18, 1000e18, 1000e18, block.timestamp + DEADLINE_OFFSET);
        } catch {
            thrown = true;
        }
        require(thrown, "tickLower below MIN_TICK should revert (TLM)");

        thrown = false;
        try {
            pool.mint(address(this), -600, 887280, 1000e18, 1000e18, 1000e18, block.timestamp + DEADLINE_OFFSET);
        } catch {
            thrown = true;
        }
        require(thrown, "tickUpper above MAX_TICK should revert (TUM)");
    }

    function it_mint_rejects_zero_liquidity() {
        _approveBoth(1000e18, 1000e18);
        bool thrown = false;
        try {
            pool.mint(address(this), -600, 600, 0, 1000e18, 1000e18, block.timestamp + DEADLINE_OFFSET);
        } catch {
            thrown = true;
        }
        require(thrown, "Zero liquidity mint should revert");
    }

    function it_mint_rejects_expired_deadline() {
        _approveBoth(1000e18, 1000e18);
        fastForward(100);
