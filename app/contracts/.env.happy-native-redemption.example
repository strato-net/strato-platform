# Native redemption happy-path runner env
# Copy to .env.happy-native-redemption and fill in real values.

# STRATO-side native contracts
STRATO_NATIVE_BRIDGE_ADDRESS=
STRATO_NATIVE_CUSTODY_VAULT_ADDRESS=
STRATO_TOKEN_ADDRESS=
STRATO_RECIPIENT_ADDRESS=

# External chain config (Sepolia example)
EXTERNAL_CHAIN_ID=11155111
CHAIN_11155111_RPC_URL=
CHAIN_11155111_NATIVE_REPRESENTATION_BRIDGE_ADDRESS=
CHAIN_11155111_REPRESENTATION_TOKEN_ADDRESS=

# Sepolia wallet that already holds representation tokens
REPRESENTATION_HOLDER_PRIVATE_KEY=
REDEMPTION_AMOUNT_WEI=

# Optional polling overrides
HAPPY_PATH_TIMEOUT_MS=600000
HAPPY_PATH_POLL_INTERVAL_MS=10000

# STRATO API auth used by Cirrus reads
NODE_URL=
OAUTH_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
GLOBAL_ADMIN_NAME=
GLOBAL_ADMIN_PASSWORD=
