# Native withdrawal happy-path runner env
# Copy to .env.happy-native-withdrawal and fill in real values.

# STRATO-side native contracts
STRATO_NATIVE_BRIDGE_ADDRESS=
STRATO_NATIVE_CUSTODY_VAULT_ADDRESS=
STRATO_TOKEN_ADDRESS=

# STRATO account that holds the native token and will request withdrawal
STRATO_WITHDRAWER_ADDRESS=
STRATO_WITHDRAWER_NAME=
STRATO_WITHDRAWER_PASSWORD=
WITHDRAWAL_AMOUNT_WEI=

# External chain config (Sepolia example)
EXTERNAL_CHAIN_ID=11155111
CHAIN_11155111_RPC_URL=
CHAIN_11155111_REPRESENTATION_TOKEN_ADDRESS=
EXTERNAL_RECIPIENT_ADDRESS=

# Optional polling overrides
HAPPY_PATH_TIMEOUT_MS=900000
HAPPY_PATH_POLL_INTERVAL_MS=10000

# STRATO API auth used by contract calls and Cirrus reads
NODE_URL=
OAUTH_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
