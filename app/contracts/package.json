{
    "name": "blockapps-contract-deployer",
    "version": "1.0.0",
    "description": "Modular tool for deploying contracts to BlockApps platform",
    "main": "deploy/deploy.js",
    "scripts": {
        "configure:native-route": "node deploy/configure-native-route.js",
        "deploy": "node deploy/deploy.js",
        "deployProxy": "node deploy/deployProxy.js",
        "happy:eth-deposit": "node deploy/happy-eth-deposit.js",
        "happy:eth-withdrawal": "node deploy/happy-eth-withdrawal.js",
        "happy:native-redemption": "node deploy/happy-native-redemption.js",
        "happy:native-withdrawal": "node deploy/happy-native-withdrawal.js",
        "initialize:native-bridge": "node deploy/initialize-native-bridge.js",
        "smoke:native-bridge": "node deploy/smoke-native-bridge.js",
        "upgrade": "node deploy/upgrade.js",
        "bridge:ops": "node deploy/bridge-usdc-route-migration.js",
        "bridge:ops:testnet": "node deploy/bridge-usdc-route-migration.js --env testnet",
        "bridge:ops:prod": "node deploy/bridge-usdc-route-migration.js --env prod",
        "bridge:trustless:deploy": "node deploy/deployTrustlessBridge.js",
        "bridge:trustless:deploy:testnet": "node deploy/deployTrustlessBridge.js --env testnet",
        "bridge:trustless:deploy:prod": "node deploy/deployTrustlessBridge.js --env prod",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "dependencies": {
        "@openzeppelin/contracts": "^5.4.0",
        "@openzeppelin/contracts-upgradeable": "^5.4.0",
        "blockapps-rest": "^8.4.0",
        "dotenv": "^10.0.0",
        "ethers": "^6.15.0",
        "fs-extra": "^10.0.0",
        "path": "^0.12.7"
    },
    "engines": {
        "node": ">=14.0.0"
    },
    "keywords": [
        "blockchain",
        "blockapps",
        "smart-contracts",
        "solidity",
        "deployment"
    ],
    "author": "",
    "license": "MIT"
}
