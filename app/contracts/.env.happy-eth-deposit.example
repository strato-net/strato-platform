# Non-native ETH deposit smoke runner env
# Copy to .env.happy-eth-deposit and fill in real values.

# Existing non-native STRATO bridge
BRIDGE_ADDRESS=

# ETH route on Sepolia
EXTERNAL_CHAIN_ID=11155111
CHAIN_11155111_RPC_URL=
CHAIN_11155111_DEPOSIT_ROUTER_ADDRESS=
STRATO_ETH_TOKEN_ADDRESS=0x93fb7295859b2d70199e0a4883b7c320cf874e6c

# Sepolia wallet that will send ETH into DepositRouter
EXTERNAL_SENDER_PRIVATE_KEY=
DEPOSIT_AMOUNT_WEI=

# STRATO recipient that should receive the mapped ETH token
STRATO_RECIPIENT_ADDRESS=

# Optional polling overrides
HAPPY_PATH_TIMEOUT_MS=600000
HAPPY_PATH_POLL_INTERVAL_MS=10000

# STRATO API auth used by Cirrus reads
NODE_URL=
OAUTH_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
GLOBAL_ADMIN_NAME=
GLOBAL_ADMIN_PASSWORD=
