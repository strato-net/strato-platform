            attestedBodyRoot:       bytes32(hex"b0998c0e8d2fb6b6e2499cbce5cdd9fd442d16687477016277957388a1c315d9"),
            participationBits:      _participationBits(),
            signature:              _signature(),
            signatureSlot:          uint64(10182753),
            nextPubkeys:            _nextCommittee(),
            nextAggregatePubkey:    _nextAggregate(),
            nextBranch:             _nextBranch()
        });
    }

    function beforeEach() {
        lc = new EthLightClient(address(this));
        lc.bootstrap(uint64(1243), _bootstrapCommittee(), _gvr(), _forkVersion());
    }

    /**
     * @notice Acid test: advance from period 1243 → 1244.
     */
    function it_advances_real_sepolia_period_transition() {
        require(lc.committeeSize(uint64(1243)) == 512, "period 1243 missing");
        require(lc.committeeSize(uint64(1244)) == 0, "period 1244 already anchored");

        uint64 advanced = lc.advanceCommittee(_update());
        require(advanced == 1244, "newPeriod mismatch");
        require(lc.committeeSize(uint64(1244)) == 512, "period 1244 not anchored");
        require(lc.latestPeriod() == 1244, "latestPeriod not advanced");
    }

    /**
     * @notice Idempotency: if 1244 is already anchored, the call
     *         is a no-op (returns 0). This protects racing callers.
     */
    function it_advance_committee_is_idempotent() {
        lc.advanceCommittee(_update());
        require(lc.committeeSize(uint64(1244)) == 512, "first advance failed");
        uint64 advanced2 = lc.advanceCommittee(_update());
        require(advanced2 == 0, "second advance should be no-op");
    }
}

