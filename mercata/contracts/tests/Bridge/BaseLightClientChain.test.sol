import "../../concrete/Bridge/BaseLightClient.sol";
import "../../concrete/Bridge/EthLightClient.sol";
import "../../libraries/Bridge/ILightClient.sol";

contract TestableEthLightClient5 is EthLightClient {
    constructor(address owner_) EthLightClient(owner_) {}
    function adminAnchor(
        uint256 blockNumber,
        bytes32 receiptsRoot,
        bytes32 stateRoot,
        uint64 beaconSlot,
        uint64 timestamp
    ) external onlyOwner {
        anchored[blockNumber] = AnchoredHeader({
            blockNumber: blockNumber,
            receiptsRoot: receiptsRoot,
            stateRoot: stateRoot,
            beaconSlot: beaconSlot,
            timestamp: timestamp
        });
    }
}

/**
 * @title  Describe_BaseLightClientChain
 * @notice End-to-end test of {BaseLightClient.anchorBaseBlockChainViaCannon}
 *         against a real Base Sepolia anchor block + 8 consecutive
 *         parent headers. Mirrors {Describe_BaseLightClientCannon}'s
 *         setup (synthetic L1 DGC bound to real L2 outputRoot) and
 *         layers the parent walk on top.
 *
 *         Verifies:
 *           1. Anchor block lands via the standard Cannon path.
 *           2. Each parent header is independently anchored.
 *           3. Each parent's keccak matches its child's parentHash
 *              (the chain walk's authentication step).
 *           4. Each parent's number is exactly child.number - 1.
 *           5. {getReceiptsRoot} works for every block in the walk.
 *
 *         Fixture generated by tests/Bridge/fixtures/base-cannon-chain-fixture.js.
 */
contract Describe_BaseLightClientChain {
    BaseLightClient bc;
    TestableEthLightClient5 lc;
    address admin;

    address constant FACTORY = address(0xd6E6dBf4F7EA0ac412fD8b65ED297e64BB7a06E1);
    bytes32 constant DGC_SIG =
        bytes32(hex"5b565efe82411da98814f356d0e7bcb8f0219b8d970307c5afb4a6903a8b2e35");

    // === Generated by base-cannon-chain-fixture.js ===
    // Anchor block 41155366 + 8 parents (41155358..41155366).
    uint256 constant L1_BLOCK_NUMBER = 12345;
    uint256 constant TX_INDEX  = 1;
    uint256 constant LOG_INDEX = 0;
    uint256 constant ANCHOR_BLOCK_NUMBER = 41155366;
    uint256 constant OLDEST_BLOCK_NUMBER = 41155358;
    uint256 constant CHAIN_DEPTH = 8;

    function _l1ReceiptsRoot() internal pure returns (bytes32) {
        return bytes32(hex"d9483781c4c6e1c956b05664b2f70a3050e3c9b03ca4968810846b9b9719535e");
    }
    function _withdrawalStorageRoot() internal pure returns (bytes32) {
        return bytes32(hex"934496e633c68d6bc7512da33a4fbbf044c9581e4895c77cd6bb358f65cb4519");
    }
    function _anchorReceiptsRoot() internal pure returns (bytes32) {
        return bytes32(hex"170194c324f38a93a89ae25d63f6d92ee83ba65248b67ea3b1af7dd6dbba9185");
    }

    function _anchorHeaderRLP() internal pure returns (bytes) {
        return hex"";
    }

    function _receiptValueBytes() internal pure returns (bytes) {
        return hex"";
    }

    function _mptProof() internal pure returns (bytes[] memory proof) {
        proof = new bytes[](3);
        proof[0] = hex"f851a06681e7f4a8d443b1fedbc6a053c1449cf73a8f5ff26dd479a8c29c83b6d8c59f80808080808080a0cc38d2208d78c8e2c3b63660627fb95881aec8923de22623e3ff3164241e45d58080808080808080";
        proof[1] = hex"f85180a05a721c4eeb83a679d6d02df1f00715244f2ffc286fff16157b67c3e879dc3b4fa069a30841e12aea055e245507fe44e86fd8be72bc0f48151c7e8f0e9e34a400ab8080808080808080808080808080";
        proof[2] = hex"";
    }

    function _parentChain() internal pure returns (bytes[] memory chain) {
        chain = new bytes[](8);
        chain[0] = hex"";
        chain[1] = hex"";
        chain[2] = hex"";
        chain[3] = hex"";
        chain[4] = hex"";
        chain[5] = hex"";
        chain[6] = hex"";
        chain[7] = hex"";
    }

    function _expectedParentReceiptsRoots() internal pure returns (bytes32[] memory rs) {
        rs = new bytes32[](8);
        rs[0] = bytes32(hex"4cacdcf9d3c1b26b0e4d0653a68445bea666bd09c0c7b42b59fd2688d6bf9770");
        rs[1] = bytes32(hex"3d39c1070ec7bbb271682f3f137b61cf9f7ab58b043c46593649f441e5d7ab48");
        rs[2] = bytes32(hex"3acc5cddb6d31ab0b0fdbf091e7ba56fefefd81a2bcdd62f4e677172bba7effc");
        rs[3] = bytes32(hex"56a8d20802c2c946244b56fdf947e936d033f48ad9814627d5a7ac5b961ce369");
        rs[4] = bytes32(hex"fd7f25be8e1b72c17e971747724c0f025da9ecdeef422b0365d517258fda70fd");
        rs[5] = bytes32(hex"d16744e0e02dafd30a168a2fb3c2ee80640bd473dfdfad8dca5a50acdaef4b91");
        rs[6] = bytes32(hex"306ae399c4d6626e7b21561771461981ac3dde29ef400d53925baaf2fef8759d");
        rs[7] = bytes32(hex"501faf96d966e4abde25c082d9d1f85c5a8af9f1636dfff01a816c7821b2498f");
    }

    function _proof() internal pure returns (OutputReceiptProof memory p) {
        p = OutputReceiptProof({
            l1BlockNumber: L1_BLOCK_NUMBER,
            txIndex: TX_INDEX,
            logIndex: LOG_INDEX,
            receiptValueBytes: _receiptValueBytes(),
            mptProof: _mptProof()
        });
    }

    function beforeEach() {
        admin = address(this);
        lc = new TestableEthLightClient5(admin);
        bc = new BaseLightClient(admin, EthLightClient(address(lc)), FACTORY, DGC_SIG);
        lc.adminAnchor(L1_BLOCK_NUMBER, _l1ReceiptsRoot(), bytes32(0), uint64(0), uint64(0));
    }

    function it_anchors_chain_end_to_end() {
        (uint256 anchorNum, uint256 oldestNum) =
            bc.anchorBaseBlockChainViaCannon(_proof(), _anchorHeaderRLP(), _withdrawalStorageRoot(), _parentChain());
        require(anchorNum == ANCHOR_BLOCK_NUMBER, "anchor block number");
        require(oldestNum == OLDEST_BLOCK_NUMBER, "oldest block number");
        // Anchor itself anchored.
        require(bc.getReceiptsRoot(ANCHOR_BLOCK_NUMBER) == _anchorReceiptsRoot(), "anchor receiptsRoot");
        require(bc.isAnchored(ANCHOR_BLOCK_NUMBER), "anchor isAnchored");
        // Each parent in the walk anchored to its real receiptsRoot.
        bytes32[] memory expectedRs = _expectedParentReceiptsRoots();
        for (uint256 i = 0; i < CHAIN_DEPTH; i = i + 1) {
            uint256 num = ANCHOR_BLOCK_NUMBER - 1 - i;
            require(bc.getReceiptsRoot(num) == expectedRs[i], "parent receiptsRoot");
            require(bc.isAnchored(num), "parent isAnchored");
        }
    }

    function it_works_with_empty_parent_chain() {
        // parentChain = [] should behave identically to anchorBaseBlockViaCannon.
        bytes[] memory empty = new bytes[](0);
        (uint256 anchorNum, uint256 oldestNum) =
            bc.anchorBaseBlockChainViaCannon(_proof(), _anchorHeaderRLP(), _withdrawalStorageRoot(), empty);
        require(anchorNum == ANCHOR_BLOCK_NUMBER, "anchor block number");
        require(oldestNum == ANCHOR_BLOCK_NUMBER, "oldest == anchor with empty chain");
        require(bc.isAnchored(ANCHOR_BLOCK_NUMBER), "anchor isAnchored");
        // No parent should be anchored.
        require(!bc.isAnchored(ANCHOR_BLOCK_NUMBER - 1), "no parent anchored");
    }

    function it_rejects_broken_parent_link() {
        // Swap in a wrong parent header for index 3 — the keccak check
        // should fire at iteration 3.
        bytes[] memory bad = _parentChain();
        bytes original = bad[3];
        bad[3] = bad[4];                   // any other valid header
        bool reverted = false;
        try {
            bc.anchorBaseBlockChainViaCannon(_proof(), _anchorHeaderRLP(), _withdrawalStorageRoot(), bad);
        } catch {
            reverted = true;
        }
        require(reverted, "should revert on broken parentHash link");
        // Restore for any subsequent assertions (defensive — beforeEach
        // re-creates anyway).
        bad[3] = original;
    }
}
