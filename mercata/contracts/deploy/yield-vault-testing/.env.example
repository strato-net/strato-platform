# Copy to .env in this directory and replace every REPLACE_ME value.
# Never commit the populated .env.

NODE_URL=https://node1.testnet.strato.nexus
OAUTH_URL=https://keycloak.blockapps.net/auth/realms/mercata/.well-known/openid-configuration
OAUTH_CLIENT_ID=REPLACE_ME
OAUTH_CLIENT_SECRET=REPLACE_ME
EXPECTED_NETWORK_ID=REPLACE_ME
# EXPECTED_NETWORK_NAME=REPLACE_ME
REQUIRE_TESTNET=true

# Funding verifies the live DeciderState pointer, active account code hash,
# fee-token address, and fee amount against fee-policy.js. That reviewed policy,
# not generic network metadata, is authoritative. Unknown policies fail closed.
FEE_TOKEN_ADDRESS=REPLACE_ME

# MINTER may directly own ASSET_ADDRESS/FEE_TOKEN_ADDRESS, or their storage
# owner may be ADMIN_REGISTRY with nonzero live MINTER adminMap membership.
# Governed funding authenticates MINTER plus dedicated APPROVER and never falls
# back to transfers.
MINTER_USERNAME=REPLACE_ME
MINTER_PASSWORD=REPLACE_ME
MINTER_ADDRESS=REPLACE_ME

# DEPLOYER is a separate authenticated role used only to submit createContract.
# On Helium it must be the Cirrus-indexed deployment authority (Admin #1).
# It does not sign setLogicContract or any YieldVault onlyOwner call.
DEPLOYER_USERNAME=REPLACE_ME
DEPLOYER_PASSWORD=REPLACE_ME
DEPLOYER_ADDRESS=REPLACE_ME

# Each submitting actor authenticates independently. OWNER_ADDRESS is always
# the authenticated signer; --expected-owner may instead be ADMIN_REGISTRY when
# live adminMap membership is proven. Other *_ADDRESS values are cross-checked
# against funding/seed manifests and transaction effects.
OWNER_USERNAME=REPLACE_ME
OWNER_PASSWORD=REPLACE_ME
OWNER_ADDRESS=REPLACE_ME

# Dedicated second Helium admin. Every governed operation repeats the exact
# primary target/function/arguments with this independently authenticated signer.
# Must be a live AdminRegistry member distinct from each operation's primary
# signer; on Helium this is the third of the three admin accounts.
APPROVER_USERNAME=REPLACE_ME
APPROVER_PASSWORD=REPLACE_ME
APPROVER_ADDRESS=REPLACE_ME

ALICE_USERNAME=REPLACE_ME
ALICE_PASSWORD=REPLACE_ME
ALICE_ADDRESS=REPLACE_ME

BOB_USERNAME=REPLACE_ME
BOB_PASSWORD=REPLACE_ME
BOB_ADDRESS=REPLACE_ME

CAROL_USERNAME=REPLACE_ME
CAROL_PASSWORD=REPLACE_ME
CAROL_ADDRESS=REPLACE_ME

STRATEGY_USERNAME=REPLACE_ME
STRATEGY_PASSWORD=REPLACE_ME
STRATEGY_ADDRESS=REPLACE_ME

SMOKE_USER_USERNAME=REPLACE_ME
SMOKE_USER_PASSWORD=REPLACE_ME
SMOKE_USER_ADDRESS=REPLACE_ME

REWARD_DISTRIBUTOR_USERNAME=REPLACE_ME
REWARD_DISTRIBUTOR_PASSWORD=REPLACE_ME
REWARD_DISTRIBUTOR_ADDRESS=REPLACE_ME

DAVE_USERNAME=REPLACE_ME
DAVE_PASSWORD=REPLACE_ME
DAVE_ADDRESS=REPLACE_ME

DONOR_USERNAME=REPLACE_ME
DONOR_PASSWORD=REPLACE_ME
DONOR_ADDRESS=REPLACE_ME

# LOSS_SINK receives tokens but does not submit a transaction.
LOSS_SINK_ADDRESS=REPLACE_ME

ASSET_ADDRESS=REPLACE_ME
ASSET_CONTRACT_NAME=Token
ADMIN_REGISTRY=000000000000000000000000000000000000100c
# Required storage owner for both Proxy and YieldVault. Governed Helium runs use
# AdminRegistry; direct-owner disposable runs may use OWNER_ADDRESS.
VAULT_OWNER_ADDRESS=000000000000000000000000000000000000100c
VAULT_PROXY=REPLACE_ME
OLD_IMPLEMENTATION=REPLACE_ME

# Optional cross-check; the E2E script reads the authoritative address from the
# completed safe-upgrade runbook report.
# NEW_IMPLEMENTATION=REPLACE_ME

# Exact SHA-256 hashes of the in-memory combined sources submitted by the local
# deployment/upgrade workflows.
EXPECTED_PROXY_SOURCE_HASH=REPLACE_ME
EXPECTED_OLD_REVIEWED_SOURCE_HASH=REPLACE_ME
EXPECTED_REVIEWED_SOURCE_HASH=REPLACE_ME

# Canonical artifact paths, relative to mercata/contracts. Funding derives its
# locked resumable run-state as <funding-manifest-path>.run-state.json.
SEED_MANIFEST_PATH=./yield-vault-seed-manifest.json
E2E_REPORT_PATH=./yield-vault-upgrade-e2e-report.json
# Required by seed-old: schemaVersion 2, yield-vault-old-proxy-deployment.
OLD_PROXY_EVIDENCE_PATH=./yield-vault-old-proxy-evidence-cirrus.json
# Defaults consumed by runbook-report: schemaVersion 1 proxy-upgrade-evidence
# and yield-vault-manual-upgrade-evidence, respectively.
UPGRADE_EVIDENCE_PATH=./yield-vault-upgrade-evidence.json
MANUAL_UPGRADE_EVIDENCE_PATH=./yield-vault-manual-upgrade-evidence.json
# Optional independently validated historical rollback artifact.
# ROLLBACK_DRILL_EVIDENCE_PATH=./yield-vault-rollback-evidence.json
# Generated schemaVersion 1 yield-vault-safe-upgrade report.
RUNBOOK_REPORT_PATH=./yield-vault-safe-upgrade-report.json

# Required schemaVersion 2 evidence emitted by the separate funding script.
YIELD_VAULT_FUNDING_MANIFEST=./yield-vault-funding-manifest.json

# Optional transaction settings.
GAS_PRICE=10
GAS_LIMIT=5000000
YIELD_VAULT_POLL_INTERVAL_MS=2000

# Must be explicitly enabled for staged disposable-environment tests.
YIELD_VAULT_DISPOSABLE_TEST=false
