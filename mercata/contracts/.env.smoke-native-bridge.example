# Native bridge smoke runner env
# Copy to .env.smoke-native-bridge and fill in real values.

# STRATO-side native contracts
STRATO_NATIVE_BRIDGE_ADDRESS=
STRATO_NATIVE_CUSTODY_VAULT_ADDRESS=
STRATO_TOKEN_ADDRESS=

# External chain config (Sepolia example)
CHAIN_11155111_RPC_URL=
CHAIN_11155111_NATIVE_REPRESENTATION_BRIDGE_ADDRESS=
CHAIN_11155111_REPRESENTATION_TOKEN_ADDRESS=

# Optional runtime role checks
BRIDGE_OPERATOR=
NATIVE_MINT_ATTESTATION_SIGNERS=
GUARDIAN=

# STRATO API auth used by Cirrus reads
NODE_URL=
OAUTH_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
GLOBAL_ADMIN_NAME=
GLOBAL_ADMIN_PASSWORD=
