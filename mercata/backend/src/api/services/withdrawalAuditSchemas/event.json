{
  "table": "/event",
  "source": "Generic Cirrus event table used across backend helpers",
  "confidence": "codebase-inferred",
  "knownColumns": {
    "event_name": {
      "type": "string",
      "usage": "Filter by Solidity event name"
    },
    "address": {
      "type": "address_string_no_0x",
      "usage": "Emitting contract address"
    },
    "attributes": {
      "type": "object",
      "usage": "Decoded event args. Supports attributes->>field filters."
    },
    "block_timestamp": {
      "type": "timestamp_string",
      "usage": "Ordering and display"
    },
    "block_number": {
      "type": "integer_string_or_number",
      "usage": "Coarse event order; not sufficient by itself for same-block ordering"
    },
    "transaction_hash": {
      "type": "string",
      "usage": "Transaction evidence and grouping"
    },
    "transaction_sender": {
      "type": "address_string_no_0x",
      "usage": "Transaction sender. Cirrus error hints confirm this column exists."
    }
  },
  "knownMissingColumns": {
    "transaction_index": {
      "reason": "Cirrus returned column event.transaction_index does not exist"
    },
    "event_index": {
      "reason": "Not found in codebase query usage; do not select until manually verified"
    },
    "log_index": {
      "reason": "Not found in codebase query usage; do not select until manually verified"
    }
  },
  "supportedFilters": [
    "event_name=eq.<EventName>",
    "address=eq.<emittingContract>",
    "attributes->>field=eq.<value>",
    "attributes->>field=in.(<values>)",
    "or=(event_name.eq.A,event_name.eq.B)"
  ],
  "safeSelect": [
    "event_name",
    "address",
    "attributes",
    "block_timestamp",
    "block_number",
    "transaction_hash",
    "transaction_sender"
  ],
  "wasEvents": {
